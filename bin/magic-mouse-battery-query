#!/bin/sh
# magic-mouse-battery-query: ask a Magic Mouse for its battery level right now
# (HID GET_REPORT 0x90 on /dev/hidrawN, which the udev rule grants to the logged-in user).
#
# The work is done by the magic-mouse-daemon next to this file (`magic-mouse-daemon battery-query`).
# When that is the Python daemon (install.sh's fallback), magic-mouse-battery-query.py does it instead.
here=$(dirname "$(readlink -f "$0")")
daemon="$here/magic-mouse-daemon"
if [ "$(head -c 2 "$daemon" 2>/dev/null)" = "#!" ]; then
  exec /usr/bin/python3 "$here/magic-mouse-battery-query.py" "$@"
fi
exec "$daemon" battery-query "$@"
