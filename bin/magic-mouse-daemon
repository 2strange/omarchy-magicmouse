#!/usr/bin/python3
"""magic-mouse-daemon: Mac-like Apple Magic Mouse for Wayland (made for Omarchy).

Grabs the Magic Mouse's evdev node (kernel hid_magicmouse driver) and re-emits
a virtual mouse called "magic-mouse-omarchy" with:

  pointer   acceleration computed here from a smoothed velocity, so Bluetooth
            bursts cannot make the cursor jump; click tolerance so the cursor
            does not creep while you press.
  scroll    synthesized from the touch surface (the kernel's emulated wheel is
            ignored): a finger has to travel a little before scrolling starts,
            resting and gripping fingers are ignored, a finger has to slide
            well beyond what the mouse itself moves, one axis at a
            time, natural direction, speed ramps with finger speed.
  momentum  flick and lift: the page keeps going and eases out.

Hyprland only needs a flat profile for the virtual device (see hypr-input.lua).
Config: ~/.config/magic-mouse/config.toml (hot-reloaded on save).
"""
from __future__ import annotations

import argparse
import array
import collections
import fcntl
import glob
import json
import math
import os
import select
import signal
import socket
import subprocess
import sys
import threading
import time
import tomllib
import errno, secrets, stat

from evdev import AbsInfo, InputDevice, UInput, ecodes as e

VIRT_NAME = "magic-mouse-omarchy"
VPAD_NAME = "Magic Mouse virtual touchpad"  # touchpad mode; Hyprland calls it the line below
VPAD_HYPR = "magic-mouse-virtual-touchpad"
APPLE_VENDORS = {0x004C, 0x05AC}
MAGIC_MOUSE_PRODUCTS = {0x030D, 0x0269, 0x0323}  # Magic Mouse 1, Magic Mouse 2, Magic Mouse USB-C
CONFIG_PATH = os.path.expanduser(
    os.environ.get("MAGIC_MOUSE_CONFIG", "~/.config/magic-mouse/config.toml")
)

HIRES = 120  # REL_WHEEL_HI_RES units per wheel notch
HIRES_PER_MM = 13.0  # base: 1 mm of finger = ~0.11 notch (about 6 px in most apps)
# The kernel driver advertises the touch surface at 26 units/mm (X) and 70 units/mm
# (Y), which is wrong: the reported ranges span the whole ~57 x 100 mm shell, so
# both axes are really ~38 units/mm. Using the advertised values skews distances
# and makes slightly diagonal swipes look horizontal. We use a uniform scale.
TOUCH_UNITS_PER_MM = 38.0
HORIZONTAL_RATIO = 2.0  # sideways travel must beat lengthwise travel by this much to scroll horizontally
TICK_HZ = 125
TICK = 1.0 / TICK_HZ
RESCAN_SEC = 2.0
NOMINAL_DT = 0.011  # Magic Mouse reports at ~90 Hz
SCROLL_SPEED_MS = 40.0  # smoothing window for the finger speed that drives the scroll ramp
SCROLL_VEL_MS = 60.0  # smoothing window for the wheel velocity momentum starts from
# Which finger scrolls. Holding the mouse leaves fingers resting on the surface
# (typically one on the far edge and one near the left button), and a flick
# pushes the mouse a little. Measured on a Magic Mouse USB-C: scroll strokes
# slide >= 4x (mostly >10x) farther than the mouse moves; resting fingers drift
# < 2x the mouse's own travel.
# Edge zones (a touch landing there holds the mouse) are scroll.edge_*_mm in the config.
PAIR_MOVING_MM = 0.25  # a second finger moving this much within MOVE_WINDOW...
PAIR_RATIO = 0.3  # ...and at least this share of the first finger's travel, the same way, joins it
MOVE_WINDOW = 0.12  # seconds; "is this finger moving" looks this far back
MOVING_MM = 0.5  # travel within MOVE_WINDOW that makes a finger moving rather than resting
MIN_SLIDE_MM = 1.0  # while the mouse moves, a scroll needs this much slide within MOVE_WINDOW...
POINTER_RATIO = 3.0  # ...and this many times the distance the mouse itself moved
CLICK_QUIET = 0.25  # seconds around a press or release in which no scroll starts (a pressing finger rolls)
# hid-magicmouse never sets INPUT_MT_DROP_UNUSED and never calls input_mt_sync_frame
# for the mouse. A HID touch report lists every live contact; a motion-only packet
# (MOUSE2 size 8) lists none. A 1–2 report tracking-id flicker or TOUCH_STATE_NONE
# then looks like a lift unless we expire unmentioned slots and bridge a brief gap.
BRIDGE_MS = 0.06
# evdev drops unchanged values, so a resting or slow finger is often missing from a
# touch report although it is still down (seen on the Magic Mouse 1). Such a slot is
# only expired after this long without a mention, and comes back if it is mentioned
# again without a new tracking id.
STALE_SEC = 0.3
FIRM_REPORTS = 3  # a finger must show this many big reports in a row, at scroll.touch_rate or faster
# The mouse firmware's own contact state, the upper nibble of the byte hid-magicmouse sends as
# EV_MSC/MSC_RAW with report_undeciphered=1 (macOS MTTouchState): 1 start in range, 2 hovering,
# 3 making touch, 4 touching, 5 breaking touch, 6 lingering, 7 out of range. The driver reports
# every state but 0 as a contact; only these touch.
FW_TOUCHING = (3, 4)
FW_PAIR_GAP_MM = 30.0  # a firmware swipe pair lies this close (index and middle finger), not thumb and ring finger on both sides
UNDECIPHERED = "/sys/module/hid_magicmouse/parameters/report_undeciphered"
EDGE_STRAIGHT = 0.6  # an edge finger is released only when its travel is at least this share of its path
JUMP_MM = 5.0  # a slot moving this far in one report without a new tracking id is a new finger
# Free (diagonal) scrolling: the smaller axis is dropped while it is below this share of
# the larger one, so a straight scroll does not wobble sideways.
SURFACE_LENGTH_MM = (2047 + 1589) / TOUCH_UNITS_PER_MM  # front-to-back span of the touch surface
FREE_MINOR = 0.35
FREE_DIR_MS = 80.0  # smoothing window for the direction that decides which axes count


def EVIOCGMTSLOTS(length: int) -> int:
    return (2 << 30) | (length << 16) | (ord("E") << 8) | 0x0A


class Touch:
    """One finger on the surface, from landing to lift."""

    __slots__ = ("x", "y", "x0", "y0", "ptr0", "grip", "palm", "hist", "firm", "ok", "last_rep", "size", "rate", "path", "edge0", "fw")

    def __init__(self, ts: float, x: int, y: int, grip: bool, palm: bool = False) -> None:
        self.x, self.y, self.grip, self.palm = x, y, grip or palm, palm
        self.x0, self.y0 = x, y
        self.ptr0 = 0.0  # Engine.ptr_total when the finger landed
        self.firm = 0  # big, closely spaced reports in a row (a real touch, not a hover)
        self.ok = False  # confirmed as a touch: it may scroll
        self.last_rep: float | None = None
        self.size = 0
        self.rate = 0.0  # this finger's reports per second, smoothed (for the preview)
        self.path = 0.0  # distance travelled along the way, in touch units (a wobble adds up, a slide too)
        self.edge0 = grip and not palm  # landed in an edge zone (grip may be cleared later)
        self.fw = -1  # the mouse's own contact state when it tells one (FW_TOUCHING), else -1
        self.hist: collections.deque = collections.deque([(ts, x, y)])

    def update(self, ts: float, x: int, y: int) -> None:
        self.path += math.hypot(x - self.x, y - self.y)
        self.x, self.y = x, y
        self.hist.append((ts, x, y))
        while len(self.hist) > 2 and self.hist[1][0] <= ts - MOVE_WINDOW:
            self.hist.popleft()

    def recent(self) -> tuple[int, int]:
        """Displacement in touch units over (about) the last MOVE_WINDOW."""
        _, x, y = self.hist[0]
        return self.x - x, self.y - y

    def straightness(self) -> float:
        """Distance from start to end over path length, over (about) the last MOVE_WINDOW:
        1 for a straight slide, near 0 for a wobble on the spot. 1 while it has not moved."""
        pts = list(self.hist)
        path = sum(math.hypot(b[1] - a[1], b[2] - a[2]) for a, b in zip(pts, pts[1:]))
        return math.hypot(*self.recent()) / path if path > 0 else 1.0

DEFAULTS = {
    "pointer": {
        "tracking_speed": 0.6875,  # macOS "Tracking speed" slider, 0.0 .. 3.0 (Apple default 0.6875)
        "cpi": 1300,  # Magic Mouse sensor resolution
        "speed": 1.0,  # extra multiplier on top of the macOS curve (screen DPI fudge)
        "smoothing_ms": 30.0,  # velocity smoothing window
        "click_hold_ms": 80.0,  # freeze pointer this long after a press...
        "click_drag_units": 12.0,  # ...unless it moves this far (then it's a drag)
    },
    "scroll": {
        "natural": True,  # content follows the finger (macOS)
        "invert_y": False,  # flip if forward/back is wrong on your model
        "invert_x": False,
        "speed": 1.0,
        "start_mm": 0.8,  # finger must travel this far before scrolling starts
        "settle_ms": 150.0,  # the mouse counts as moving if it moved within this long...
        "settle_counts": 4.0,  # ...by more than this many raw counts (then a scroll needs POINTER_RATIO more slide)
        "accel": 0.6,  # 0 = linear, 1 = strong ramp with finger speed
        "horizontal": True,
        # A finger scrolls only after a real touch: contact size at least touch_start_size in
        # FIRM_REPORTS reports in a row at touch_rate or faster (a hovering finger reports less often). Then it
        # keeps scrolling down to touch_hold_size, as less of the fingertip touches while it
        # slides. A second finger next to a confirmed one, or two fingers landing together,
        # need only the smaller of touch_hold_size and touch_pair_size.
        # 0 = off. Contact size is the mouse's own scale (0..1020), shown in the touch preview.
        "touch_start_size": 300.0,
        "touch_hold_size": 250.0,
        "touch_pair_size": 250.0,  # two fingers at this size or more both count at once (0 = the hold size)
        "touch_rate": 42.0,  # reports per second a touch must reach (touch ~60-77, hover ~40); 0 = any rate
        # Near the front the finger lies flatter: a hover there is as big as a light touch further
        # back (measured: hover ~470, touch ~710 within 15 mm). Within touch_front_mm a single finger
        # needs touch_front_size to start, easing back to touch_start_size over as far again.
        "touch_front_size": 510.0,  # 0 = off (same start size everywhere)
        "touch_front_mm": 13.0,
        # A hovering finger wobbles on the spot, a real slide goes one way (measured: hover ~0.1,
        # slides 0.77 and more). A finger goes down on the virtual touchpad, or joins one already
        # down, only while its travel over the last MOVE_WINDOW is at least this straight
        # (distance from start to end / path length). 0 = off.
        "touch_straight": 0.5,
        # Play on the virtual touchpad: a finger already down moves it only once it pushes past this,
        # so a wobble on the spot is no scroll back and forth. A slide runs on without a jerk, a turn
        # costs this much travel. 0 = off.
        "touch_reverse_mm": 0.5,
        # Trust the mouse's own touch state where the driver passes it on (hid_magicmouse
        # report_undeciphered=1): a finger counts exactly while the firmware says it touches,
        # the size rules above apply only without it.
        "touch_firmware": True,
        "free_axis": False,  # diagonal scrolling: both axes at once instead of locking to one per scroll
        # A touch that lands this close to the left, right or front edge counts as holding the mouse...
        "edge_left_mm": 3.0,
        "edge_right_mm": 3.0,
        "edge_front_mm": 2.0,
        "edge_release_mm": 3.0,  # ...until it slides this far, straight on (more than the mouse moves): then it may scroll
        "edge_back_mm": 18.0,  # touches that start this close to the back are the palm: always ignored (0 = off)
    },
    "buttons": {
        "middle": "left",  # a click in the centre zone: "left" (macOS has no middle click), "middle", or "right"
        "right_click": True,  # a click on the right side is a right click; false = left click (macOS "Secondary click: Off")
        "control_click": False,  # Control + click = right click, like macOS (a Hyprland binding on the virtual mouse only)
    },
    "gestures": {
        "swipe_pages": True,  # quick one-finger sideways flick = browser back / forward
        "swipe_mm": 8.0,  # travel needed for a swipe
        "invert_swipe": False,  # swap the two-finger swipe directions
        # At the last (or first) workspace the default two-finger swipe actions...
        # "wrap": jump around to the other end, "new": open a new workspace (forward only), "stop": do nothing
        "swipe_end": "wrap",
        "include_empty": True,  # empty workspaces count (1-5 always, like the bar); false = only open ones
        # Hyprland's socket takes Lua: "dispatch <lua>" runs hl.dispatch(<lua>). Same call as Omarchy's Super+Tab.
        "two_finger_swipe_left": 'dispatch hl.dsp.focus({ workspace = "e+1" })',  # like "swipe between full-screen apps"
        "two_finger_swipe_right": 'dispatch hl.dsp.focus({ workspace = "e-1" })',
        "two_finger_double_tap": "",  # Mission Control on macOS; any "dispatch ..." or shell command
        "double_tap": "",  # smart zoom on macOS; any "dispatch ..." or shell command
    },
    "touchpad": {
        # Touchpad mode: the fingers the daemon follows go to a virtual touchpad, one finger more
        # (1 -> 2 = touchpad scrolling, apps scroll and glide themselves; 2 -> 3 = Hyprland's live
        # workspace swipe). Scroll settings, momentum and the two-finger swipe above then rest;
        # edges, palm and the touch check still decide which fingers count.
        "enabled": True,
        "scroll_speed": 0.35,  # Hyprland scroll_factor for the virtual touchpad (the surface is long: scrolls far)
        "swipe_gain": 2.7,  # with two fingers, finger travel counts this many times (the mouse is small)
        "swipe": True,  # two fingers sideways = the workspace swipe; off: they only scroll
        "swipe_reverse": False,  # the mouse swipes the other way round than the trackpad (Hyprland's direction)
    },
    "bar": {
        "show_percent": True,  # bar widget: show the number next to the icon (the panel's switch)
    },
    "battery": {
        "enabled": True,  # ask the mouse for its charge (needs the udev rule for /dev/hidraw access)
        "poll_minutes": 15.0,
        # Tell BlueZ the charge, so Bluetooth settings (the Omarchy panel too) show it next to the mouse.
        # BlueZ knows no battery for a classic Bluetooth mouse on its own.
        "bluez": True,
    },
    "momentum": {
        "enabled": True,
        "flick": 900.0,  # hires units/s needed at lift to coast
        "decay": 0.97,  # per 8 ms tick; lower = shorter glide
        "stop": 60.0,
        "max_seconds": 2.5,
    },
}


def log(msg: str) -> None:
    print(msg, flush=True)


# --------------------------------------------------------------------------- files
# Every file this program reads or writes on the user's behalf (config, status)
# goes through these two helpers: descriptor-first, never following symlinks,
# never blocking on a planted FIFO, and never writing through a predictable
# temporary name.
MAX_OWN_FILE_BYTES = 1 << 20


def read_own_file(path: str, max_bytes: int = MAX_OWN_FILE_BYTES) -> bytes:
    """Read a small regular file owned by this user. O_NOFOLLOW so a planted
    symlink is not followed, O_NONBLOCK so a planted FIFO cannot block us,
    fstat (type, owner, size) before any read, and a bounded read."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(errno.EINVAL, "not a regular file", path)
        if st.st_uid != os.getuid():
            raise OSError(errno.EPERM, "not owned by this user", path)
        if st.st_size > max_bytes:
            raise OSError(errno.EFBIG, f"larger than {max_bytes} bytes", path)
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            total += len(chunk)
            if total > max_bytes:
                raise OSError(errno.EFBIG, f"larger than {max_bytes} bytes", path)
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(fd)


def open_private_dir(directory: str) -> int:
    """Create `directory` owner-only (0700) if it is missing, and return a
    descriptor for it. An existing directory is accepted only if it is a real
    directory (not a symlink) owned by this user that group and others cannot
    write to: anyone who can write there can swap or plant entries, including a
    FIFO where the status file should be. Anything else is refused, not repaired."""
    try:
        os.mkdir(directory, 0o700)
    except FileExistsError:
        pass
    dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        st = os.fstat(dfd)
        if st.st_uid != os.getuid():
            raise OSError(errno.EPERM, "directory not owned by this user", directory)
        if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
            raise OSError(errno.EPERM, f"directory is writable by group or others (mode {st.st_mode & 0o777:04o})", directory)
    except BaseException:
        os.close(dfd)
        raise
    return dfd


def write_own_file(path: str, data: bytes, mode: int = 0o600, private_dir: bool = False) -> None:
    """Atomically replace `path` with `data`. The directory must be owned by this
    user and is opened O_NOFOLLOW and held (with private_dir, it is also created
    0700 and refused if group or others can write to it); the existing target may
    only be a regular file; the data goes to a random same-directory O_CREAT|
    O_EXCL|O_NOFOLLOW temp file, is fsynced through that descriptor, then renamed
    into place; the temp file is removed on any failure."""
    directory, name = os.path.split(path)
    if private_dir:
        dfd = open_private_dir(directory)
    else:
        os.makedirs(directory, mode=0o700, exist_ok=True)
        dfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        if os.fstat(dfd).st_uid != os.getuid():
            raise OSError(errno.EPERM, "directory not owned by this user", directory)
        try:
            existing = os.stat(name, dir_fd=dfd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            if not stat.S_ISREG(existing.st_mode):
                raise OSError(errno.EINVAL, "existing target is not a regular file", path)
        tmp = f".{name}.{secrets.token_hex(8)}.tmp"
        tfd = os.open(tmp, os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, mode, dir_fd=dfd)
        try:
            view = memoryview(data)
            while view:
                view = view[os.write(tfd, view):]
            os.fsync(tfd)
            os.rename(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
            raise
        finally:
            os.close(tfd)
        os.fsync(dfd)
    finally:
        os.close(dfd)


# --------------------------------------------------------------------------- config
def load_config(path: str) -> dict:
    cfg = {k: dict(v) for k, v in DEFAULTS.items()}
    try:
        user = tomllib.loads(read_own_file(path).decode("utf-8"))
    except FileNotFoundError:
        return cfg
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as exc:
        log(f"config: {exc} (using defaults)")
        return cfg
    for sect, vals in user.items():
        if sect not in cfg or not isinstance(vals, dict):
            log(f"config: unknown section [{sect}] ignored")
            continue
        if sect == "scroll":
            vals = dict(vals)
            # earlier keys of this fork: one edge width for both sides, palm zone as a share
            if "edge_mm" in vals:
                old = vals.pop("edge_mm")
                vals.setdefault("edge_left_mm", old)
                vals.setdefault("edge_right_mm", old)
            if "palm_zone" in vals:
                pz = vals.pop("palm_zone")
                if isinstance(pz, (int, float)) and not isinstance(pz, bool):
                    vals.setdefault("edge_back_mm", float(pz) * SURFACE_LENGTH_MM)
        for k, v in vals.items():
            if k not in cfg[sect]:
                log(f"config: unknown key {sect}.{k} ignored")
                continue
            want = DEFAULTS[sect][k]
            if isinstance(want, bool):
                ok = isinstance(v, bool)
            elif isinstance(want, (int, float)):
                ok = isinstance(v, (int, float)) and not isinstance(v, bool) and math.isfinite(v)
                if ok and isinstance(want, float):
                    v = float(v)
            else:
                ok = isinstance(v, type(want))
            if ok:
                cfg[sect][k] = v
            else:  # a wrong type would crash the daemon later; keep the default instead
                log(f"config: {sect}.{k} = {v!r} is not a {type(want).__name__}, using the default")
    return cfg


def config_mtime(path: str) -> float:
    try:
        return os.stat(path).st_mtime
    except OSError:
        return -1.0


# --------------------------------------------------------------------------- devices
def is_magic_mouse(dev: InputDevice) -> bool:
    caps = dev.capabilities()
    by_id = dev.info.vendor in APPLE_VENDORS and dev.info.product in MAGIC_MOUSE_PRODUCTS
    by_name = "magic mouse" in dev.name.lower()
    if not (by_id or by_name):
        return False
    return (
        e.REL_X in caps.get(e.EV_REL, [])
        and e.BTN_LEFT in caps.get(e.EV_KEY, [])
        and e.EV_ABS in caps
    )


def find_mice(skip: set[str]) -> list[InputDevice]:
    """Every Magic Mouse not in skip (paths already grabbed)."""
    found = []
    for path in sorted(glob.glob("/dev/input/event*")):
        if path in skip:
            continue
        try:
            dev = InputDevice(path)
        except OSError:
            continue
        if dev.name not in (VIRT_NAME, VPAD_NAME) and is_magic_mouse(dev):
            found.append(dev)
        else:
            dev.close()
    return found


def make_uinput() -> UInput:
    cap = {
        e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE, e.BTN_SIDE, e.BTN_EXTRA],
        e.EV_REL: [
            e.REL_X, e.REL_Y,
            e.REL_WHEEL, e.REL_HWHEEL,
            e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES,
        ],
    }
    return UInput(cap, name=VIRT_NAME, vendor=0x004C, product=0x0269, version=1)


# --------------------------------------------------------------------------- macOS curve
# Apple's pointer acceleration, straight from IOHIDFamily
# (IOHIDEventSystemPlugIns/IOHIDAccelerationAlgorithm.cpp, IOHIDParametricAcceleration).
# Ten stock curves indexed by the "Tracking speed" setting; the driver linearly
# interpolates between the two nearest. Values are IOFixed (x / 65536):
#   (Index, GainLinear, GainParabolic, GainCubic, GainQuartic, TangentSpeedLinear, TangentSpeedParabolicRoot)
APPLE_CURVES_FIXED = [
    (0,      65536, 0,      0,     0, 524288, 0),
    (8192,   60293, 26214,  5243,  0, 537395, 1245184),
    (32768,  60948, 36045,  6554,  0, 543949, 1179648),
    (45056,  61604, 46531,  7864,  0, 550502, 1114112),
    (57344,  62259, 57672,  9830,  0, 557056, 1048576),
    (65536,  62915, 69468,  11796, 0, 563610, 983040),
    (98304,  63570, 81920,  14418, 0, 570163, 917504),
    (131072, 64225, 95027,  17695, 0, 576717, 851968),
    (163840, 64881, 108790, 21627, 0, 583270, 786432),
    (196608, 65536, 123208, 26214, 0, 589824, 786432),
]
MAC_CURSOR_PPI = 96.0  # Apple maps curve output (cursor inches/s) to pixels at 96 px per inch


class AppleCurve:
    """f(x): mouse speed in inches/s -> cursor speed in inches/s (before the 96 ppi scale).

    Three segments, exactly as Apple's driver: polynomial up to TangentSpeedLinear,
    then its tangent line up to TangentSpeedParabolicRoot, then a square-root tail.
    """

    def __init__(self, tracking: float) -> None:
        curves = [tuple(v / 65536.0 for v in c) for c in APPLE_CURVES_FIXED]
        tracking = max(0.0, float(tracking))
        cur = 0
        for i, c in enumerate(curves):
            if tracking >= c[0]:
                cur = i
        c0 = curves[cur]
        if c0[0] < tracking and cur + 1 < len(curves):
            c1 = curves[cur + 1]
            r = (tracking - c0[0]) / (c1[0] - c0[0])
            c = tuple(a + r * (b - a) for a, b in zip(c0, c1))
        else:
            c = c0
        _, gl, gp, gc, gq, tl, tp = c
        self.gl = gl
        self.tl = tl
        self.poly = lambda x: gl * x + (gp * x) ** 2 + (gc * x) ** 3 + (gq * x) ** 4
        dpoly = lambda x: gl + 2 * x * gp**2 + 3 * x * x * gc**3 + 4 * x**3 * gq**4
        self.t0 = self.t1 = float("inf")
        self.m0 = self.b0 = self.m1 = self.b1 = 0.0
        if tl != 0:
            y0 = self.poly(tl)
            self.m0 = dpoly(tl)
            self.b0 = y0 - self.m0 * tl
            self.t0 = tl
            if tp != 0:
                y1 = self.m0 * tp + self.b0
                self.m1 = 2 * y1 * self.m0
                self.b1 = y1 * y1 - self.m1 * tp
                self.t1 = tp
        elif tp != 0:
            y0 = self.poly(tp)
            self.m1 = dpoly(tp)
            self.b1 = y0 * y0 - self.m1 * tp
            self.t0 = tp

    def f(self, x: float) -> float:
        if x <= self.t0:
            return self.poly(x)
        if x <= self.t1 and self.t0 == self.tl:
            return self.m0 * x + self.b0
        return math.sqrt(max(self.m1 * x + self.b1, 0.0))

    def gain(self, x: float) -> float:
        """Cursor inches per mouse inch at mouse speed x (inches/s)."""
        if x < 1e-6:
            return self.gl
        return self.f(x) / x


# --------------------------------------------------------------------------- battery
# The Magic Mouse reports its charge in HID *input* report 0x90, which it pushes
# on its own schedule (can be a long while after connecting). The kernel/UPower
# show 0% until then. A GET_REPORT on the raw HID node makes the mouse answer at
# once; the kernel ignores that answer, so we publish it ourselves.
BATTERY_REPORT_ID = 0x90
STATUS_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "magic-mouse")
STATUS_FILE = os.path.join(STATUS_DIR, "battery.json")


def hidraw_for(dev: InputDevice) -> str | None:
    want_uniq = f"HID_UNIQ={dev.uniq}".lower() if dev.uniq else None
    want_id = f"HID_ID=0005:{dev.info.vendor:08X}:{dev.info.product:08X}"
    by_id = None
    for p in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            ue = open(f"{p}/device/uevent").read()
        except OSError:
            continue
        if want_uniq and want_uniq in ue.lower():
            return "/dev/" + os.path.basename(p)  # this very mouse (two of a model share the ID)
        if by_id is None and want_id in ue:
            by_id = "/dev/" + os.path.basename(p)
    return by_id  # no node names this address: the first of the model, as before


def parse_battery_report(buf: bytes) -> tuple[int, bool] | None:
    """report 0x90: [id, flags, percent, ...]; flags bit2 = charging (usage 0x85/0x44)."""
    if len(buf) < 3 or buf[0] != BATTERY_REPORT_ID:
        return None
    percent = int(buf[2])
    if not 0 <= percent <= 100:
        return None
    return percent, bool(buf[1] & 0x04)


def query_battery(hidraw: str) -> tuple[int, bool] | None:
    buf = bytearray(4)
    buf[0] = BATTERY_REPORT_ID
    ioc = (3 << 30) | (len(buf) << 16) | (ord("H") << 8) | 0x0A  # HIDIOCGINPUT(len)
    try:
        with open(hidraw, "rb+", buffering=0) as f:
            fcntl.ioctl(f, ioc, buf)
    except OSError as exc:
        log(f"battery: {hidraw}: {exc}")
        return None
    return parse_battery_report(bytes(buf))


def write_status(data: dict) -> None:
    """Publish `data` for the bar widget. If the status directory is not safe
    (not ours, or group/other-writable) nothing is written and the daemon keeps
    running; the reason goes to the journal and the widget falls back to UPower."""
    try:
        write_own_file(STATUS_FILE, json.dumps(data).encode("utf-8"), private_dir=True)
    except OSError as exc:
        log(f"status: not publishing battery status to {STATUS_DIR}: {exc} "
            "(fix or remove that directory; the next status write retries)")


def kernel_battery(dev: InputDevice) -> int | None:
    """The charge the kernel publishes for the mouse (power_supply hid-<address>-battery), if it knows one."""
    if not dev.uniq:
        return None
    for p in glob.glob(f"/sys/class/power_supply/hid-{dev.uniq.lower()}-battery*/capacity"):
        try:
            value = int(open(p).read().strip())
        except (OSError, ValueError):
            continue
        if 0 < value <= 100:  # 0 = the mouse has not reported yet
            return value
    return None


class BluezBattery:
    """Tells BlueZ the mouse's charge through its BatteryProvider API (org.bluez.BatteryProviderManager1),
    so every Bluetooth UI shows it. Runs a GLib main loop in a thread for BlueZ's calls; set() and
    clear() hand over to it. Without python-gobject or BlueZ it logs once and does nothing."""

    ROOT = "/io/github/twostrange/magicmouse/battery"
    MANAGER_XML = (
        '<node><interface name="org.freedesktop.DBus.ObjectManager">'
        '<method name="GetManagedObjects"><arg type="a{oa{sa{sv}}}" direction="out"/></method>'
        '<signal name="InterfacesAdded"><arg type="o"/><arg type="a{sa{sv}}"/></signal>'
        '<signal name="InterfacesRemoved"><arg type="o"/><arg type="as"/></signal>'
        '</interface></node>')
    PROVIDER_XML = (
        '<node><interface name="org.bluez.BatteryProvider1">'
        '<property name="Device" type="o" access="read"/>'
        '<property name="Percentage" type="y" access="read"/>'
        '<property name="Source" type="s" access="read"/>'
        '</interface></node>')

    def __init__(self) -> None:
        self.bus = None
        self.adapters: set[str] = set()  # adapters we registered with
        self.objects: dict[str, tuple[int, str, int]] = {}  # our path -> (registration id, device path, percent)
        try:
            import gi
            gi.require_version("Gio", "2.0")
            from gi.repository import Gio, GLib
        except (ImportError, ValueError) as exc:
            log(f"battery: no python-gobject, not telling Bluetooth settings the charge ({exc})")
            return
        self.Gio, self.GLib = Gio, GLib
        try:
            self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
            self.manager_info = Gio.DBusNodeInfo.new_for_xml(self.MANAGER_XML).interfaces[0]
            self.provider_info = Gio.DBusNodeInfo.new_for_xml(self.PROVIDER_XML).interfaces[0]
            self.bus.register_object(self.ROOT, self.manager_info, self.on_manager_call, None, None)
            # bluetoothd restarted (or an adapter came back): our registration is gone with it
            Gio.bus_watch_name_on_connection(self.bus, "org.bluez", Gio.BusNameWatcherFlags.NONE,
                                             None, lambda *_: self.forget())
        except Exception as exc:  # GLib.Error
            log(f"battery: no system bus for Bluetooth settings: {exc}")
            self.bus = None
            return
        threading.Thread(target=GLib.MainLoop().run, daemon=True).start()

    def on_manager_call(self, conn, sender, path, iface, method, params, invocation) -> None:
        GLib = self.GLib
        objects = {p: {"org.bluez.BatteryProvider1": self.props(dev, pct)} for p, (_, dev, pct) in self.objects.items()}
        invocation.return_value(GLib.Variant("(a{oa{sa{sv}}})", (objects,)))

    def props(self, dev: str, pct: int) -> dict:
        V = self.GLib.Variant
        return {"Device": V("o", dev), "Percentage": V("y", pct), "Source": V("s", "magic-mouse-daemon")}

    def get_prop(self, conn, sender, path, iface, name):
        _, dev, pct = self.objects[path]
        return self.props(dev, pct)[name]

    def device_path(self, address: str) -> str | None:
        """BlueZ's object for the device with this address (/org/bluez/hciN/dev_XX_...)."""
        reply = self.bus.call_sync("org.bluez", "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects",
                                   None, None, self.Gio.DBusCallFlags.NONE, 2000, None)
        for path, ifaces in reply.unpack()[0].items():
            d = ifaces.get("org.bluez.Device1")
            if d and str(d.get("Address", "")).lower() == address.lower():
                return path
        return None

    def set(self, address: str, percent: int) -> None:
        if self.bus and address:
            self.GLib.idle_add(self._set, address, int(percent))

    def clear(self, address: str) -> None:
        if self.bus and address:
            self.GLib.idle_add(self._clear, address)

    def _path(self, address: str) -> str:
        return f"{self.ROOT}/dev_{address.upper().replace(':', '_')}"

    def _set(self, address: str, percent: int) -> bool:
        GLib, path = self.GLib, self._path(address)
        reg = None
        try:
            if path in self.objects:
                reg, dev, old = self.objects[path]
                if old != percent:
                    self.objects[path] = (reg, dev, percent)
                    self.bus.emit_signal(None, path, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                         GLib.Variant("(sa{sv}as)", ("org.bluez.BatteryProvider1",
                                                                     {"Percentage": GLib.Variant("y", percent)}, [])))
                return False
            dev = self.device_path(address)
            if dev is None:
                return False  # BlueZ does not know the mouse (yet); the next poll tries again
            adapter = dev.rsplit("/", 1)[0]
            reg = self.bus.register_object(path, self.provider_info, None, self.get_prop, None)
            self.objects[path] = (reg, dev, percent)
            if adapter not in self.adapters:
                self.bus.call_sync("org.bluez", adapter, "org.bluez.BatteryProviderManager1", "RegisterBatteryProvider",
                                   GLib.Variant("(o)", (self.ROOT,)), None, self.Gio.DBusCallFlags.NONE, 5000, None)
                self.adapters.add(adapter)  # BlueZ now asks GetManagedObjects and picks the battery up
            else:
                self.bus.emit_signal(None, self.ROOT, "org.freedesktop.DBus.ObjectManager", "InterfacesAdded",
                                     GLib.Variant("(oa{sa{sv}})", (path, {"org.bluez.BatteryProvider1": self.props(dev, percent)})))
            log(f"battery: {percent}% handed to Bluetooth settings")
        except Exception as exc:  # GLib.Error: BlueZ gone, no BatteryProviderManager1, ...
            log(f"battery: Bluetooth settings: {exc}")
            if reg is not None:  # or every later try fails with "already exported"
                try:
                    self.bus.unregister_object(reg)
                except Exception:
                    pass
            self.objects.pop(path, None)
        return False

    def forget(self) -> None:
        """BlueZ went away: drop every battery; the next set() registers anew."""
        for reg, _, _ in self.objects.values():
            self.bus.unregister_object(reg)
        self.objects.clear()
        self.adapters.clear()

    def _clear(self, address: str) -> bool:
        path = self._path(address)
        if path in self.objects:
            reg, _, _ = self.objects.pop(path)
            self.bus.unregister_object(reg)
            self.bus.emit_signal(None, self.ROOT, "org.freedesktop.DBus.ObjectManager", "InterfacesRemoved",
                                 self.GLib.Variant("(oas)", (path, ["org.bluez.BatteryProvider1"])))
        return False


# --------------------------------------------------------------------------- actions
PROBE_PATH = os.path.join(STATUS_DIR, "probe.sock")
PROBE_MAX_CLIENTS = 4


class Probe:
    """Live touch stream for the preview window: a Unix socket in the owner-only
    status directory. Each connected client gets one JSON line per input frame
    (a "hello" line first with the surface geometry). Clients only listen; what
    they send is discarded. A client that cannot keep up loses frames instead of
    stalling the daemon, and nothing is computed while nobody is connected."""

    def __init__(self) -> None:
        self.sock: socket.socket | None = None
        self.clients: list[socket.socket] = []
        self.stalls: dict[socket.socket, int] = {}  # consecutive frames a client could not take
        self.hello: dict = {}

    def open(self) -> None:
        try:
            os.close(open_private_dir(STATUS_DIR))  # create 0700 / refuse an unsafe directory
            try:
                st = os.lstat(PROBE_PATH)
            except FileNotFoundError:
                pass
            else:
                if not stat.S_ISSOCK(st.st_mode):
                    raise OSError(errno.EEXIST, "not a socket, refusing to replace it", PROBE_PATH)
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_CLOEXEC) as other:
                    try:
                        other.connect(PROBE_PATH)
                    except OSError:
                        pass  # stale socket from a previous run
                    else:
                        raise OSError(errno.EADDRINUSE, "another daemon owns the probe socket", PROBE_PATH)
                os.unlink(PROBE_PATH)
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM | socket.SOCK_NONBLOCK | socket.SOCK_CLOEXEC)
            sock.bind(PROBE_PATH)
            os.chmod(PROBE_PATH, 0o600)
            sock.listen(PROBE_MAX_CLIENTS)
            self.sock = sock
            log(f"probe: {PROBE_PATH}")
        except OSError as exc:
            log(f"probe disabled: {exc}")

    def fds(self) -> list:
        return ([self.sock] if self.sock else []) + self.clients

    def handle(self, ready: list) -> None:
        if self.sock and self.sock in ready:
            try:
                conn, _ = self.sock.accept()
            except OSError:
                conn = None
            if conn is not None:
                if len(self.clients) >= PROBE_MAX_CLIENTS:
                    conn.close()
                else:
                    conn.setblocking(False)
                    self.clients.append(conn)
                    self.send(dict(self.hello, type="hello"), [conn])
        for c in [c for c in self.clients if c in ready]:
            try:
                data = c.recv(4096)
            except BlockingIOError:
                continue
            except OSError:
                data = b""
            if not data:
                self.drop(c)

    def send(self, obj: dict, targets: list | None = None) -> None:
        line = (json.dumps(obj, separators=(",", ":")) + "\n").encode()
        for c in list(targets if targets is not None else self.clients):
            try:
                sent = c.send(line, socket.MSG_DONTWAIT | socket.MSG_NOSIGNAL)
            except BlockingIOError:
                # slow reader: skip this frame for it; one that never reads gives its slot back
                self.stalls[c] = self.stalls.get(c, 0) + 1
                if self.stalls[c] > 200:
                    self.drop(c)
                continue
            except OSError:
                self.drop(c)
                continue
            if sent < len(line):
                self.drop(c)  # a cut line would corrupt the stream
            else:
                self.stalls.pop(c, None)

    def drop(self, c: socket.socket) -> None:
        if c in self.clients:
            self.clients.remove(c)
        self.stalls.pop(c, None)
        try:
            c.close()
        except OSError:
            pass

    def close(self) -> None:
        for c in list(self.clients):
            self.drop(c)
        if self.sock:
            self.sock.close()
            self.sock = None
            try:
                os.unlink(PROBE_PATH)
            except OSError:
                pass


def hypr_socket() -> str | None:
    rt = os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    if sig and os.path.exists(f"{rt}/hypr/{sig}/.socket.sock"):
        return f"{rt}/hypr/{sig}/.socket.sock"
    socks = glob.glob(f"{rt}/hypr/*/.socket.sock")
    return max(socks, key=os.path.getmtime) if socks else None


def hypr_request(cmd: str, timeout: float = 0.5) -> str | None:
    """One synchronous request on Hyprland's command socket; None if it can't be reached."""
    sock = hypr_socket()
    if not sock:
        return None
    try:
        with socket.socket(socket.AF_UNIX) as c:
            c.settimeout(timeout)
            c.connect(sock)
            c.sendall(cmd.encode())
            out = b""
            while chunk := c.recv(4096):
                out += chunk
            return out.decode("utf-8", "replace")
    except OSError as exc:
        log(f"hyprland: {exc}")
        return None


# Control-click = right click. Hyprland knows the keyboard's modifiers; this
# daemon deliberately never reads the keyboard. So Hyprland gets a binding for
# Control + left press, limited to our virtual mouse, whose only effect is to
# swallow that press and post an event on its event socket. The daemon answers
# it with a right click on the same virtual device, so the click is routed
# like any real one (window under the cursor, layer surfaces, menus).
CONTROL_CLICK_EVENT = "custom>>magic-mouse>>control-click"
_LUA_UNBIND = ("if _G.magic_mouse_control_click then pcall(function() _G.magic_mouse_control_click:unbind() end) "
               "_G.magic_mouse_control_click = nil end")
_LUA_BIND = (_LUA_UNBIND + ' _G.magic_mouse_control_click = hl.bind("CTRL + mouse:272", '
             'hl.dsp.event("magic-mouse>>control-click"), '
             f'{{ device = {{ inclusive = true, list = {{ "{VIRT_NAME}" }} }}, '
             'description = "Magic Mouse: Control-click is a right click" })')


class HyprEvents:
    """Hyprland's event socket (.socket2.sock) plus the Control-click binding it serves."""

    RETRY_SEC = 5.0

    def __init__(self) -> None:
        self.sock: socket.socket | None = None
        self.buf = b""
        self.next_try = 0.0
        self.bound: bool | None = None  # what Hyprland currently has, as far as we know
        self.next_sync = 0.0  # after a failed attempt, don't retry before this
        self.warned = False
        self.connects = 0  # successful connections so far (others re-apply runtime settings on a change)

    def fileno(self) -> int:
        return self.sock.fileno() if self.sock else -1

    def connect(self, now: float) -> None:
        if self.sock or now < self.next_try:
            return
        self.next_try = now + self.RETRY_SEC
        cmd = hypr_socket()
        if not cmd:
            return
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(os.path.join(os.path.dirname(cmd), ".socket2.sock"))
            s.setblocking(False)
        except OSError:
            return
        self.sock, self.buf = s, b""
        self.connects += 1
        self.resync()  # a new connection may be a new Hyprland

    def resync(self) -> None:
        self.bound = None
        self.next_sync = 0.0

    def close(self) -> None:
        if self.sock:
            self.sock.close()
        self.sock = None
        self.bound = None

    def read_lines(self) -> list[str]:
        try:
            chunk = self.sock.recv(65536)
        except BlockingIOError:
            return []
        except OSError:
            chunk = b""
        if not chunk:
            self.close()
            return []
        self.buf += chunk
        *lines, self.buf = self.buf.split(b"\n")
        return [l.decode("utf-8", "replace") for l in lines]

    def sync_binding(self, want: bool, now: float) -> None:
        """Called every loop pass; only talks to Hyprland when something changed."""
        if self.sock is None or self.bound == want or now < self.next_sync:
            return
        reply = hypr_request("eval " + (_LUA_BIND if want else _LUA_UNBIND))
        if reply is None or reply.strip() != "ok":
            self.next_sync = now + self.RETRY_SEC
            if reply is not None and want and not self.warned:
                log(f"control_click: Hyprland refused the binding (needs Lua-config Hyprland): {reply.strip()}")
                self.warned = True
            return
        if want or self.bound:  # at startup, clearing a leftover from an earlier run is not news
            log("control_click binding " + ("added" if want else "removed"))
        self.bound = want


def run_action(cmd: str) -> None:
    """'dispatch ...' / 'keyword ...' go straight to Hyprland's socket; anything else is a shell command.

    On Lua-config Hyprland (Omarchy 4+) the dispatch payload is Lua, e.g.
    dispatch hl.dsp.focus({ workspace = "e+1" }). Older Hyprland takes dispatch workspace e+1.
    """
    cmd = (cmd or "").strip()
    if not cmd:
        return
    if cmd.split()[0] in ("dispatch", "keyword"):
        def send() -> None:
            sock = hypr_socket()
            if not sock:
                log("action: no Hyprland socket")
                return
            try:
                with socket.socket(socket.AF_UNIX) as c:
                    c.settimeout(1.0)
                    c.connect(sock)
                    c.sendall(cmd.encode())
                    c.recv(4096)
            except OSError as exc:
                log(f"action failed: {exc}")
        threading.Thread(target=send, daemon=True).start()
    else:
        try:
            subprocess.Popen(cmd, shell=True, start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as exc:
            log(f"action failed: {exc}")


WORKSPACE_NEXT = 'workspace = "e+1"'
WORKSPACE_PREV = 'workspace = "e-1"'


_ws_lock = threading.Lock()  # one step at a time, so a quick second swipe sees the first one's result


def workspace_step(forward: bool, end: str, fallback: str, include_empty: bool = True) -> None:
    """Next or previous workspace on the focused monitor. With include_empty, workspaces 1-5
    (always shown in Omarchy's bar) and every one up to the highest open one count, open or
    not, like Spaces on a Mac; otherwise only open workspaces (like Hyprland's e+1 / e-1).
    At the end: jump to the other end ("wrap"), open a new one after the last ("new", forward
    only, up to 10) or do nothing ("stop"). Workspaces on other monitors are skipped.
    On a named workspace (negative id) the plain action runs instead."""
    def run() -> None:
        with _ws_lock:
            try:
                act = json.loads(hypr_request("j/activeworkspace") or "{}")
                spaces = json.loads(hypr_request("j/workspaces") or "[]")
                cur = int(act.get("id", 0))
                mon = act.get("monitorID")
                here = {cur}
                elsewhere = set()
                for w in spaces:
                    if isinstance(w, dict) and int(w.get("id", 0)) > 0:
                        (here if w.get("monitorID") == mon else elsewhere).add(int(w["id"]))
            except (ValueError, TypeError, AttributeError, KeyError) as exc:
                log(f"workspace step: {exc}")
                return
            if cur <= 0:
                run_action(fallback)
                return
            top = max(here)
            if include_empty:
                ids = [i for i in range(1, max(5, top) + 1) if i not in elsewhere or i in here]
            else:
                ids = sorted(here)
            pos = ids.index(cur)
            target = None
            if forward:
                if pos + 1 < len(ids):
                    target = ids[pos + 1]
                elif end == "wrap":
                    target = ids[0]
                elif end == "new":
                    target = ids[-1] + 1
                    while target in elsewhere:
                        target += 1
                    if target > 10:
                        target = None
            elif pos > 0:
                target = ids[pos - 1]
            elif end == "wrap":
                target = ids[-1]
            if target is not None and target != cur:
                hypr_request(f'dispatch hl.dsp.focus({{ workspace = "{target}" }})')
    threading.Thread(target=run, daemon=True).start()


# --------------------------------------------------------------------------- touchpad mode
VPAD_GROW = 5.0  # the virtual surface is this many times the mouse, so a swipe has room (max swipe_gain)
TP_PAIR_FRAMES = 3  # a second finger joins the virtual touchpad after pairing this many frames in a row
TP_PAIR_YOUNG = 0.15  # ...but only this soon after the first went down: a running scroll ignores other fingers
TP_SWIPE_RATIO = 1.5  # two fingers go down as a pair (the workspace swipe) only when sliding this much more sideways
TP_HOLD_SEC = 0.1  # a finger down on the virtual touchpad stays down this long while it reports too light
TP_SCROLL_GAIN = 2.0  # one finger moves this much farther on the virtual touchpad (scroll_factor divided by it):
# libinput only starts a scroll after about a millimetre, so this lets small, gentle scrolls through
TP_CATCH_UP = 0.5  # share of the travel from before the touch went down that is still owed, kept per frame
VPAD_EXTRA_MM = 12.0  # the added finger sits this far beside the first one
VPAD_TOOLS = [e.BTN_TOOL_FINGER, e.BTN_TOOL_DOUBLETAP, e.BTN_TOOL_TRIPLETAP, e.BTN_TOOL_QUADTAP, e.BTN_TOOL_QUINTTAP]


class VPad:
    """A virtual touchpad fed with the mouse's followed fingers plus one."""

    def __init__(self, xr: tuple[int, int], yr: tuple[int, int], res: float) -> None:
        def grow(r):
            c, h = (r[0] + r[1]) / 2, (r[1] - r[0]) / 2
            return int(c - h * VPAD_GROW), int(c + h * VPAD_GROW)
        self.xr, self.yr, self.res = grow(xr), grow(yr), res
        r = int(round(res))
        cap = {
            e.EV_KEY: [e.BTN_LEFT, e.BTN_TOUCH] + VPAD_TOOLS,
            e.EV_ABS: [
                (e.ABS_X, AbsInfo(0, self.xr[0], self.xr[1], 0, 0, r)),
                (e.ABS_Y, AbsInfo(0, self.yr[0], self.yr[1], 0, 0, r)),
                (e.ABS_MT_SLOT, AbsInfo(0, 0, 9, 0, 0, 0)),
                (e.ABS_MT_TRACKING_ID, AbsInfo(0, 0, 65535, 0, 0, 0)),
                (e.ABS_MT_POSITION_X, AbsInfo(0, self.xr[0], self.xr[1], 0, 0, r)),
                (e.ABS_MT_POSITION_Y, AbsInfo(0, self.yr[0], self.yr[1], 0, 0, r)),
            ],
        }
        # Bluetooth bus: libinput treats it as an external touchpad (not off with the lid, no disable-while-typing)
        self.ui = UInput(cap, name=VPAD_NAME, vendor=0x004C, product=0x0269, bustype=e.BUS_BLUETOOTH,
                         version=1, input_props=[e.INPUT_PROP_POINTER, e.INPUT_PROP_BUTTONPAD])
        self.slots: dict[int, int] = {}  # virtual tracking id -> slot
        self.ids: dict[int, int] = {}  # real tracking id -> virtual id
        self.next_id = 0
        self.extra: int | None = None
        self.extra_pos: tuple[float, float] | None = None
        self.count = 0
        self.gain = 1.0
        self.gx = 1.0  # the gain sideways, negative while a swipe is mirrored
        self.anchor: dict[int, tuple[float, float, float, float]] = {}  # real tid -> real x, y, virtual x, y
        self.last: dict[int, tuple[float, float]] = {}

    def new_id(self) -> int:
        self.next_id = self.next_id % 65000 + 1
        return self.next_id

    def update(self, fingers: list[tuple[int, float, float]], gain: float, mirror: bool = False) -> None:
        """fingers: (real tracking id, x, y) to put down; [] lifts everything.
        No virtual finger ever jumps: a finger keeps its virtual place, a new one lands
        relative to a finger that was already down, and the added finger moves along with it.
        mirror: a swipe (two or more fingers) moves the other way sideways."""
        gain = min(max(gain, 1.0), VPAD_GROW) if len(fingers) >= 2 else TP_SCROLL_GAIN
        gx = -gain if mirror and len(fingers) >= 2 else gain
        if (gain, gx) != (self.gain, self.gx):  # re-anchor, so no finger jumps on a change
            self.anchor.clear()
            self.gain = gain
        self.gx = gx
        prev = dict(self.last)
        real = {f[0] for f in fingers}
        for tid in [t for t in self.last if t not in real]:
            self.last.pop(tid, None)
            self.anchor.pop(tid, None)
        lead = next(((t, x, y) for t, x, y in fingers if t in prev), None)  # down in the last frame too
        want = []
        for tid, x, y in fingers:
            if tid not in self.ids:
                self.ids[tid] = self.new_id()
            if tid not in self.anchor:
                if tid in prev:
                    vx, vy = prev[tid]
                elif lead is not None:
                    lvx, lvy = prev[lead[0]]
                    vx, vy = lvx + (x - lead[1]), lvy + (y - lead[2])
                else:
                    vx, vy = x, y  # a fresh landing: where it really is, in the middle of the bigger surface
                self.anchor[tid] = (x, y, vx, vy)
            ax, ay, avx, avy = self.anchor[tid]
            vx = min(max(avx + (x - ax) * gx, self.xr[0]), self.xr[1])
            vy = min(max(avy + (y - ay) * gain, self.yr[0]), self.yr[1])
            self.last[tid] = (vx, vy)
            want.append((self.ids[tid], vx, vy))
        if want:
            if self.extra is not None and self.extra_pos is not None and lead is not None:
                lvx, lvy = prev[lead[0]]
                nvx, nvy = self.last[lead[0]]
                ex, ey = self.extra_pos
                self.extra_pos = (ex + nvx - lvx, ey + nvy - lvy)  # rides along with the lead finger
            else:
                self.extra = self.new_id()  # a new touch: the added finger lands too
                _, x0, y0 = want[0]
                dx = VPAD_EXTRA_MM * self.res
                self.extra_pos = (x0 + dx if x0 + dx <= self.xr[1] else x0 - dx, y0)
            ex = min(max(self.extra_pos[0], self.xr[0]), self.xr[1])
            ey = min(max(self.extra_pos[1], self.yr[0]), self.yr[1])
            want.append((self.extra, ex, ey))
        else:
            self.extra = None
            self.extra_pos = None
        keep = {v for v, _, _ in want}
        ui = self.ui
        for vid in [v for v in self.slots if v not in keep]:  # lifts
            ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots.pop(vid))
            ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, -1)
        for tid in [t for t, v in self.ids.items() if v not in keep]:
            del self.ids[tid]
        for vid, x, y in want:
            if vid not in self.slots:
                self.slots[vid] = next(i for i in range(10) if i not in self.slots.values())
            ui.write(e.EV_ABS, e.ABS_MT_SLOT, self.slots[vid])
            ui.write(e.EV_ABS, e.ABS_MT_TRACKING_ID, vid)
            ui.write(e.EV_ABS, e.ABS_MT_POSITION_X, int(x))
            ui.write(e.EV_ABS, e.ABS_MT_POSITION_Y, int(y))
        n = min(len(want), len(VPAD_TOOLS))
        if n != self.count:
            if self.count:
                ui.write(e.EV_KEY, VPAD_TOOLS[self.count - 1], 0)
            if n:
                ui.write(e.EV_KEY, VPAD_TOOLS[n - 1], 1)
            ui.write(e.EV_KEY, e.BTN_TOUCH, 1 if n else 0)
            self.count = n
        if want:
            ui.write(e.EV_ABS, e.ABS_X, int(want[0][1]))
            ui.write(e.EV_ABS, e.ABS_Y, int(want[0][2]))
        ui.syn()

    def close(self) -> None:
        try:
            self.update([], 1.0)
        except OSError:
            pass
        self.ui.close()


def vpad_lua(cfg: dict) -> str:
    """Hyprland settings for the virtual touchpad only (the built-in trackpad keeps its own)."""
    tp = cfg["touchpad"]
    natural = "true" if cfg["scroll"].get("natural") else "false"
    return (f'hl.device({{ name = "{VPAD_HYPR}", scroll_factor = {float(tp["scroll_speed"]) / TP_SCROLL_GAIN:.4f}, '
            f'natural_scroll = {natural}, tap_to_click = false }})')


# --------------------------------------------------------------------------- engine
class Engine:
    def __init__(self, cfg: dict, ui: UInput, verbose: bool) -> None:
        self.cfg = cfg
        self.ui = ui
        self.verbose = verbose
        self.record = None  # --record: raw input events, one "ts type code value" line each
        self.probe: "Probe | None" = None  # live touch view for the preview window
        self.vpad: VPad | None = None  # touchpad mode
        self.tp_key: tuple[int, ...] | None = None  # the fingers down on the virtual touchpad
        self.tp_pair_n = 0  # frames a second finger has been pairing with the one down
        self.tp_t0 = 0.0  # when the fingers on the virtual touchpad went down
        self.tp_from: tuple[float, float] = (0.0, 0.0)  # where a single finger went down (is it going sideways?)
        self.tp_light: dict[int, float] = {}  # finger down on the virtual touchpad -> since when it is too light
        self.tp_swiped = False  # a swipe ended with a finger still on: nothing more until all fingers lift
        self.tp_owed: dict[int, list[float]] = {}  # finger -> travel from before it went down, still to replay
        self.tp_out: dict[int, list[float]] = {}  # finger -> where it is on the virtual touchpad, with play (touch_reverse_mm)
        self.why = ""  # why the last frame did (or did not) scroll; for the probe
        self.why_locked = False
        self.curve = AppleCurve(float(cfg["pointer"]["tracking_speed"]))
        self.res_x = TOUCH_UNITS_PER_MM
        self.res_y = TOUCH_UNITS_PER_MM
        self.dev: InputDevice | None = None
        self.dropped = False  # SYN_DROPPED seen: skip to the next SYN_REPORT, then resync
        self.x_min, self.x_max = -1100, 1258  # touch X range; read from the device on attach
        self.y_min, self.y_max = -1589, 2047  # touch Y range (front = min, back = max)
        # frame accumulators
        self.f_dx = 0
        self.f_dy = 0
        self.f_btn: list[tuple[int, int]] = []
        # buttons
        self.pressed: dict[int, int] = {}  # physical button -> code we pressed on the virtual device
        self.left_press_t = -1.0
        self.last_button_t = -1.0
        self.right_latched = False  # a Control-click right press, released with the physical button
        # pointer
        self.v = 0.0
        self.last_motion_t = -1.0
        self.rem_x = 0.0
        self.rem_y = 0.0
        self.hold_until = 0.0
        self.hold_acc = [0.0, 0.0]
        self.recent: collections.deque = collections.deque()
        self.ptr_total = 0.0  # raw counts the mouse moved since start (edge release compares against it)
        self.lost: tuple[float, int, int] | None = None  # (ts, x, y) of the last non-grip finger that vanished  # (ts, raw distance): how much the mouse itself moved lately
        # touch
        self.slots: dict[int, list] = {}  # slot -> [tracking_id, x, y, touch_major, touch_minor]
        self.cur_slot = 0
        self.mt_frame = False  # this SYN_REPORT included ABS_MT_* (a HID touch report)
        self.mt_seen: set[int] = set()  # slots mentioned in this touch report
        self.f_reported: set[int] = set()  # the same, kept for touch() after the frame is closed
        self.slot_seen: dict[int, float] = {}  # slot -> last report that mentioned it
        self.parked: dict[int, list] = {}  # slots expired for silence; restored if they speak again
        self.slot_fw: dict[int, int] = {}  # slot -> the firmware's contact state (see FW_TOUCHING)
        self.fw_seen = False  # the driver passes the firmware state on (report_undeciphered)
        self.fw_slot_ok = False  # an ABS_MT_* event came since the last state byte: it belongs to cur_slot
        self.fw_cache: tuple[float, str] = (-1.0, "")  # (ts, fw_status()) for the probe
        self.parked_touch: dict[int, Touch] = {}  # their Touch objects, so a restore is not a new landing
        self.pending_lift: float | None = None  # apparent lift; end scroll if nothing returns within BRIDGE_MS
        self.touches: dict[int, Touch] = {}  # tracking_id -> Touch
        self.primary: tuple[int, ...] | None = None  # the finger (or two) being followed
        self.t_ref: tuple[int, int] | None = None
        self.scrolling = False
        self.axis = "y"
        self.start_axis = "y"  # axis the scroll started on (free_axis keeps page swipes working)
        self.s_travel_x = 0.0  # signed sideways travel this scroll (mm)
        self.s_rem = {"x": 0.0, "y": 0.0}
        self.s_notch = {"x": 0, "y": 0}
        self.s_vel = 0.0
        self.s_vel_xy = [0.0, 0.0]  # free_axis: wheel velocity per axis (hi-res units/s)
        self.s_dir = [0.0, 0.0]  # free_axis: smoothed finger direction (mm per frame)
        self.s_speed = 0.0  # smoothed finger speed, mm/s
        self.s_last_t = -1.0
        self.s_travel = 0.0  # signed mm along the locked axis this scroll
        self.scroll_t0 = 0.0
        # touch session (first finger down .. last finger up) and gestures
        self.session_open = False
        self.session_t0 = 0.0
        self.session_travel = 0.0
        self.session_clicked = False
        self.max_fingers = 0
        self.gesture_fired = False
        self.session_scrolled = False
        self.two_key: tuple[int, ...] | None = None
        self.two_ref: tuple[float, float] | None = None
        self.last_tap_t = -1.0
        self.last_tap_fingers = 0
        # momentum
        self.coasting = False
        self.c_vel = 0.0
        self.c_dir = (0.0, 1.0)  # free_axis glide direction (x, y share of c_vel)
        self.c_t0 = 0.0
        self.c_last_t = 0.0

    # ---- device attach
    def attach(self, dev: InputDevice) -> None:
        self.dev = dev
        self.fw_seen = False
        self.fw_cache = (-1.0, "")
        self.reset_touch()
        self.v = 0.0
        self.last_motion_t = -1.0
        try:
            info = dev.absinfo(e.ABS_MT_POSITION_X)
            self.x_min, self.x_max = info.min, info.max
            info = dev.absinfo(e.ABS_MT_POSITION_Y)
            self.y_min, self.y_max = info.min, info.max
        except OSError:
            pass
        self.sync_mt()

    def reset_touch(self) -> None:
        self.slots.clear()
        self.slot_fw.clear()
        self.parked.clear()
        self.parked_touch.clear()
        self.slot_seen.clear()
        self.touches.clear()
        self.cur_slot = 0
        self.mt_frame = False
        self.mt_seen.clear()
        self.pending_lift = None
        self.primary = None
        self.t_ref = None
        self.scrolling = False
        self.session_open = False
        self.two_key = None
        self.two_ref = None
        self.stop_coast("reset")

    def sync_mt(self) -> None:
        """Load the kernel's current multitouch state. Events only carry changes, so
        without this the first touch after a grab (or after dropped events) is filed
        under the wrong slot, and a finger that never lifts is left behind: every
        real touch then looks like a second finger and nothing scrolls."""
        if self.dev is None:
            return
        try:
            info = self.dev.absinfo(e.ABS_MT_SLOT)
            n = info.max + 1
            cols = {}
            for code in (e.ABS_MT_TRACKING_ID, e.ABS_MT_POSITION_X, e.ABS_MT_POSITION_Y,
                         e.ABS_MT_TOUCH_MAJOR, e.ABS_MT_TOUCH_MINOR):
                buf = array.array("i", [code] + [0] * n)
                fcntl.ioctl(self.dev.fd, EVIOCGMTSLOTS(len(buf) * buf.itemsize), buf, True)
                cols[code] = buf[1:]
        except OSError as exc:
            log(f"touch state: {exc}")
            return
        self.parked.clear()
        self.parked_touch.clear()
        self.slot_seen.clear()
        self.slot_fw.clear()  # not readable by ioctl: known again with the next report
        self.slots = {
            i: [cols[e.ABS_MT_TRACKING_ID][i], cols[e.ABS_MT_POSITION_X][i], cols[e.ABS_MT_POSITION_Y][i],
                cols[e.ABS_MT_TOUCH_MAJOR][i], cols[e.ABS_MT_TOUCH_MINOR][i]]
            for i in range(n) if cols[e.ABS_MT_TRACKING_ID][i] >= 0
        }
        self.cur_slot = info.value

    def update_config(self, cfg: dict) -> None:
        self.cfg = cfg
        self.curve = AppleCurve(float(cfg["pointer"]["tracking_speed"]))

    # ---- helpers
    def pointer_gain(self, v: float) -> float:
        """Pixels per raw count at smoothed speed v (raw counts/ms), macOS style."""
        p = self.cfg["pointer"]
        cpi = max(float(p["cpi"]), 1.0)
        x = v * 1000.0 / cpi  # inches per second
        return self.curve.gain(x) * MAC_CURSOR_PPI / cpi * float(p["speed"])

    def emit_rel(self, code: int, value: int) -> None:
        if value:
            self.ui.write(e.EV_REL, code, value)

    def emit_scroll(self, hires: float, axis: str) -> None:
        """Accumulate fractional hi-res units, emit hi-res + notch events."""
        self.s_rem[axis] += hires
        n = int(self.s_rem[axis])
        if n == 0:
            return
        self.s_rem[axis] -= n
        if axis == "y":
            self.emit_rel(e.REL_WHEEL_HI_RES, n)
        else:
            self.emit_rel(e.REL_HWHEEL_HI_RES, n)
        self.s_notch[axis] += n
        while abs(self.s_notch[axis]) >= HIRES:
            step = 1 if self.s_notch[axis] > 0 else -1
            self.emit_rel(e.REL_WHEEL if axis == "y" else e.REL_HWHEEL, step)
            self.s_notch[axis] -= step * HIRES

    # ---- event intake
    def feed(self, ev) -> None:
        if self.record:
            self.record.write(f"{ev.timestamp():.6f} {ev.type} {ev.code} {ev.value}\n")
        if ev.type == e.EV_SYN:
            if ev.code == e.SYN_DROPPED:
                self.dropped = True  # the kernel's buffer overflowed; state is unknown
                log("SYN_DROPPED")
            elif ev.code == e.SYN_REPORT:
                self.fw_slot_ok = False
                if self.dropped:
                    self.resync(ev.timestamp())
                else:
                    self.process_frame(ev.timestamp())
            return
        if self.dropped:
            return
        if ev.type == e.EV_REL:
            if ev.code == e.REL_X:
                self.f_dx += ev.value
            elif ev.code == e.REL_Y:
                self.f_dy += ev.value
            # kernel's emulated wheel is ignored; scroll is synthesized from touch
            return
        if ev.type == e.EV_KEY:
            if ev.code in (e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE):
                self.f_btn.append((ev.code, ev.value))
            return
        if ev.type == e.EV_MSC:
            if ev.code == e.MSC_RAW:  # follows the slot's ABS_MT_* events
                # The input core drops unchanged values, and with them the slot switch: the state
                # byte of a finger lying perfectly still would land on the slot sent last. Take a
                # byte only right after its own slot's events; a still finger keeps its last state.
                if self.fw_slot_ok:
                    self.slot_fw[self.cur_slot] = ev.value >> 4
                self.fw_slot_ok = False
                if not self.fw_seen:
                    self.fw_seen = True
                    log("touch: the mouse's own touch state is available (report_undeciphered)")
            return
        if ev.type == e.EV_ABS:
            self.fw_slot_ok = True
            # A HID touch report lists every live contact. Remember which slots
            # were addressed so process_frame can treat the rest as lifts; the
            # kernel will not (no INPUT_MT_DROP_UNUSED on this device).
            self.mt_frame = True
            if ev.code == e.ABS_MT_SLOT:
                self.cur_slot = ev.value
            self.mt_seen.add(self.cur_slot)
            if ev.code != e.ABS_MT_SLOT:
                if self.cur_slot not in self.slots and ev.code != e.ABS_MT_TRACKING_ID and self.cur_slot in self.parked:
                    self.slots[self.cur_slot] = self.parked.pop(self.cur_slot)  # still the same finger
                if ev.code == e.ABS_MT_TRACKING_ID:
                    self.slot_fw.pop(self.cur_slot, None)
                    old = self.parked.pop(self.cur_slot, None)  # a new finger (or a lift) in this slot
                    if old:
                        self.parked_touch.pop(old[0], None)
                slot = self.slots.setdefault(self.cur_slot, [-1, 0, 0, 0, 0])
                if ev.code == e.ABS_MT_TRACKING_ID:
                    slot[0] = ev.value
                elif ev.code == e.ABS_MT_POSITION_X:
                    slot[1] = ev.value
                elif ev.code == e.ABS_MT_POSITION_Y:
                    slot[2] = ev.value
                elif ev.code == e.ABS_MT_TOUCH_MAJOR:
                    slot[3] = ev.value
                elif ev.code == e.ABS_MT_TOUCH_MINOR:
                    slot[4] = ev.value
            return

    def resync(self, ts: float) -> None:
        """After SYN_DROPPED: reload touches and release buttons whose release was lost."""
        self.dropped = False
        self.mt_frame = False
        self.mt_seen.clear()
        self.f_dx = self.f_dy = 0
        self.sync_mt()
        try:
            down = set(self.dev.active_keys()) if self.dev else set(self.pressed)
        except OSError:
            down = set(self.pressed)
        self.f_btn = [(phys, 0) for phys in self.pressed if phys not in down]
        self.process_frame(ts)

    # ---- per-frame processing
    def process_frame(self, ts: float) -> None:
        # A slot not mentioned for STALE_SEC (in touch reports or motion-only ones,
        # which carry no touch data) is parked; it comes back with its Touch if it
        # speaks again without a new tracking id. A lift (-1) ends it at once.
        for s in self.mt_seen:
            self.slot_seen[s] = ts
        lifted = [s for s in self.slots if self.slots[s][0] < 0]
        silent = [s for s in self.slots if s not in self.mt_seen and s not in lifted
                  and ts - self.slot_seen.setdefault(s, ts) > STALE_SEC]
        for s in silent:
            self.parked[s] = self.slots[s]
        stale = lifted + silent
        if stale and self.verbose:
            log(f"touch: drop slots {stale}")
        for s in stale:
            del self.slots[s]
            self.slot_seen.pop(s, None)
            self.slot_fw.pop(s, None)
        self.f_reported = set(self.mt_seen)
        self.mt_frame = False
        self.mt_seen.clear()

        dx, dy, btns = self.f_dx, self.f_dy, self.f_btn
        self.f_dx = self.f_dy = 0
        self.f_btn = []

        # buttons first, so motion in the press frame is covered by click tolerance
        clicked = False
        for phys, value in btns:
            self.last_button_t = ts
            if value == 1:
                code = self.map_button(phys)
                self.pressed[phys] = code
                clicked = True
                self.stop_coast("button")
                self.hold_until = ts + float(self.cfg["pointer"]["click_hold_ms"]) / 1000.0
                self.hold_acc = [0.0, 0.0]
                if code == e.BTN_LEFT:
                    self.left_press_t = ts
            else:
                # release what was pressed, even if buttons.middle changed in between
                code = self.pressed.pop(phys, self.map_button(phys))
            self.ui.write(e.EV_KEY, code, value)
            if value == 0 and code == e.BTN_LEFT and self.right_latched:
                self.ui.write(e.EV_KEY, e.BTN_RIGHT, 0)
                self.right_latched = False

        if dx or dy:
            self.pointer(ts, dx, dy)

        self.touch(ts)
        if clicked:
            self.session_clicked = True  # after touch(), so a same-frame landing can't reset it
        self.ui.syn()
        if self.probe and self.probe.clients:
            self.publish(ts)

    def moving_now(self, ts: float) -> bool:
        """pointer_moving() without pruning self.recent, so watching never changes behaviour."""
        sc = self.cfg["scroll"]
        cut = ts - float(sc["settle_ms"]) / 1000.0
        return sum(d for t, d in self.recent if t >= cut) > float(sc["settle_counts"])

    def fw_status(self, ts: float) -> str:
        """For the preview: does the mouse's own touch state reach the daemon? The driver
        reads report_undeciphered only when the mouse connects, so switching it on needs a reconnect."""
        if ts - self.fw_cache[0] < 1.0:
            return self.fw_cache[1]
        if not self.cfg["scroll"].get("touch_firmware", True):
            status = "disabled"
        elif self.fw_seen:
            status = "active"
        else:
            try:
                ready = self.dev is not None and e.MSC_RAW in self.dev.capabilities().get(e.EV_MSC, [])
            except OSError:
                ready = False
            try:
                with open(UNDECIPHERED) as f:
                    switched = f.read().strip() in ("Y", "1")
            except OSError:
                switched = False
            status = "ready" if ready else "reconnect" if switched else "off"
        self.fw_cache = (ts, status)
        return status

    def publish(self, ts: float) -> None:
        """One probe frame: every contact with its size, role and firmware state, plus the decision."""
        follow = set(self.primary or ())
        contacts = []
        for s, v in self.slots.items():
            if v[0] < 0:
                continue
            t = self.touches.get(v[0])
            role = ("palm" if t and t.palm else "grip" if t and t.grip
                    else "hover" if t and not t.ok
                    else "follow" if v[0] in follow else "rest")
            contacts.append([v[0], v[1], v[2], v[3], v[4], role, round(t.rate) if t else 0, self.slot_fw.get(s, -1)])
        self.probe.send({
            "t": round(ts, 4),
            "c": contacts,
            "scroll": self.scrolling,
            "axis": self.axis,
            "coast": self.coasting,
            "moving": self.moving_now(ts),
            "why": self.why,
            "fw": self.fw_status(ts),
            "zones": [float(self.cfg["scroll"][k]) for k in ("edge_left_mm", "edge_right_mm", "edge_front_mm", "edge_back_mm")],
        })

    def pointer(self, ts: float, dx: int, dy: int) -> None:
        p = self.cfg["pointer"]
        dt = ts - self.last_motion_t if self.last_motion_t >= 0 else NOMINAL_DT
        if dt > 0.2:
            self.v = 0.0
            dt = NOMINAL_DT
        self.last_motion_t = ts
        dist = math.hypot(dx, dy)
        self.recent.append((ts, dist))
        self.ptr_total += dist
        keep = max(float(self.cfg["scroll"]["settle_ms"]) / 1000.0, MOVE_WINDOW)
        while self.recent and self.recent[0][0] < ts - keep:
            self.recent.popleft()
        # Smoothed velocity. A burst frame (dt ~ 0) gets ~zero weight, so it
        # cannot spike the estimate the way it does inside libinput.
        if dt > 0:
            v_inst = dist / (dt * 1000.0)
            a = 1.0 - math.exp(-(dt * 1000.0) / max(float(p["smoothing_ms"]), 1.0))
            self.v += a * (v_inst - self.v)

        if ts < self.hold_until:
            self.hold_acc[0] += dx
            self.hold_acc[1] += dy
            if math.hypot(*self.hold_acc) < float(p["click_drag_units"]):
                return  # click tolerance: swallow the creep
            self.hold_until = 0.0
            dx, dy = self.hold_acc
            self.hold_acc = [0.0, 0.0]

        gain = self.pointer_gain(self.v)
        ox = dx * gain + self.rem_x
        oy = dy * gain + self.rem_y
        ix, iy = int(ox), int(oy)
        self.rem_x, self.rem_y = ox - ix, oy - iy
        self.emit_rel(e.REL_X, ix)
        self.emit_rel(e.REL_Y, iy)

    def map_button(self, code: int) -> int:
        if code == e.BTN_RIGHT and self.cfg["buttons"]["right_click"] is False:
            return e.BTN_LEFT  # and with control_click on, Control + that click is still a right click
        if code != e.BTN_MIDDLE:
            return code
        want = str(self.cfg["buttons"]["middle"]).lower()
        return {"left": e.BTN_LEFT, "right": e.BTN_RIGHT}.get(want, e.BTN_MIDDLE)

    def control_click(self, now: float) -> None:
        """Hyprland swallowed a Control + left press on our device: answer with a right click.
        Held for as long as the physical button is, so press-drag-release in a menu works."""
        if not self.cfg["buttons"]["control_click"] or self.right_latched:
            return
        if self.left_press_t < 0 or now - self.left_press_t > 1.0:
            return  # no recent left press of ours; stale or foreign event
        self.left_press_t = -1.0
        held = e.BTN_LEFT in self.pressed.values()
        self.ui.write(e.EV_KEY, e.BTN_RIGHT, 1)
        if held:
            self.right_latched = True
        else:
            self.ui.write(e.EV_KEY, e.BTN_RIGHT, 0)  # the click was quicker than the round trip
        self.ui.syn()

    def release_buttons(self) -> None:
        """Mouse gone: never leave a button held down on the virtual device."""
        for code in set(self.pressed.values()) | ({e.BTN_RIGHT} if self.right_latched else set()):
            self.ui.write(e.EV_KEY, code, 0)
        if self.pressed or self.right_latched:
            self.ui.syn()
        self.pressed.clear()
        self.right_latched = False

    def nav(self, back: bool) -> None:
        code = e.BTN_SIDE if back else e.BTN_EXTRA
        self.ui.write(e.EV_KEY, code, 1)
        self.ui.syn()
        self.ui.write(e.EV_KEY, code, 0)
        self.ui.syn()
        if self.verbose:
            log("swipe: " + ("back" if back else "forward"))

    def pointer_moving(self, ts: float) -> bool:
        """Has the mouse itself really moved within the last settle_ms?"""
        s = self.cfg["scroll"]
        cut = ts - float(s["settle_ms"]) / 1000.0
        while self.recent and self.recent[0][0] < cut:
            self.recent.popleft()
        return sum(d for _, d in self.recent) > float(s["settle_counts"])

    def pointer_mm(self, ts: float, window: float) -> float:
        """How far the mouse itself moved, in mm, within the last `window` seconds."""
        counts = sum(d for t, d in self.recent if t >= ts - window)
        return counts * 25.4 / max(float(self.cfg["pointer"]["cpi"]), 1.0)

    def touch(self, ts: float) -> None:
        live = {v[0]: (v[1], v[2]) for v in self.slots.values() if v[0] >= 0}
        # a report with no width (TOUCH_MINOR 0) is a finger hovering over the edge, often with
        # half its coordinates missing: it counts as size 0, never as a touch
        reports = {v[0]: (v[3] if v[4] > 0 else 0) for s, v in self.slots.items() if v[0] >= 0 and s in self.f_reported}
        fw = {v[0]: self.slot_fw[s] for s, v in self.slots.items() if v[0] >= 0 and s in self.slot_fw}
        parked_ids = {v[0] for v in self.parked.values()}
        for tid in [t for t in self.touches if t not in live]:
            gone = self.touches.pop(tid)
            if tid in parked_ids:
                self.parked_touch[tid] = gone  # silent, not lifted: keep it for a restore
                continue
            if not gone.grip:
                self.lost = (ts, gone.x, gone.y)
        for tid in [t for t in self.parked_touch if t not in parked_ids and t not in live]:
            del self.parked_touch[tid]
        sc = self.cfg["scroll"]
        mm = lambda key: max(float(sc[key]), 0.0)
        left_to = self.x_min + mm("edge_left_mm") * self.res_x
        right_from = self.x_max - mm("edge_right_mm") * self.res_x
        front_to = self.y_min + mm("edge_front_mm") * self.res_y
        palm_from = self.y_max - mm("edge_back_mm") * self.res_y
        for tid, (x, y) in live.items():
            t = self.touches.get(tid)
            if t is None and tid in self.parked_touch:
                t = self.touches[tid] = self.parked_touch.pop(tid)  # the same finger, speaking again
            elif t is not None and math.hypot(x - t.x, y - t.y) / self.res_x > JUMP_MM:
                del self.touches[tid]  # a new finger reusing the slot and the id: a new landing
                if tid in (self.primary or ()):
                    self.t_ref = None
                t = None
            if t is None:
                grip = (mm("edge_left_mm") > 0 and x <= left_to) or (mm("edge_right_mm") > 0 and x >= right_from) \
                    or (mm("edge_front_mm") > 0 and y <= front_to)
                palm = mm("edge_back_mm") > 0 and y >= palm_from
                if (grip or palm) and self.lost and ts - self.lost[0] < BRIDGE_MS \
                        and math.hypot(x - self.lost[1], y - self.lost[2]) / self.res_x < 5.0:
                    grip = palm = False  # a tracking-id flicker of a scrolling finger, not a new grip
                self.touches[tid] = Touch(ts, x, y, grip, palm)
                self.touches[tid].ptr0 = self.ptr_total
            else:
                t.update(ts, x, y)
                if t.grip and not t.palm and math.hypot(*t.recent()) / self.res_x < MOVING_MM / 2:
                    t.x0, t.y0, t.path, t.ptr0 = x, y, 0.0, self.ptr_total  # at rest: a later slide is judged from here
                if t.grip and not t.palm and self.edge_finger_slides(ts, t):
                    t.grip = False  # it came in from the edge but really slides: let it scroll
                    t.hist.clear()
                    t.hist.append((ts, x, y))  # judge its movement from here, not from the edge
                    if self.verbose:
                        log(f"edge finger {tid} released")

        self.confirm_touches(ts, reports, fw)
        self.why_locked = False  # a gesture's reason must not be overwritten later in the frame
        fingers = sorted(tid for tid, t in self.touches.items() if not t.grip and t.ok)
        if self.vpad is not None:
            self.touchpad_frame(ts, fingers)
            return
        if not fingers:
            light = [t.size for t in self.touches.values() if not t.grip]
            self.why = (f"not touching yet (size {max(light)})" if light
                        else "only grip fingers" if self.touches else "no touch")
            # A 1–2 report dropout (TOUCH_STATE_NONE, or the kernel leaving a
            # slot up because it never syncs unused contacts) looks like a lift.
            # Wait BRIDGE_MS before ending the scroll so a flicker can hand off.
            if self.scrolling:
                if self.pending_lift is None:
                    self.pending_lift = ts
                if ts - self.pending_lift < BRIDGE_MS:
                    return
                self.end_session(self.pending_lift)
                self.pending_lift = None
            elif self.session_open:
                self.end_session(ts)
            return
        self.pending_lift = None
        if not self.session_open:
            self.session_open = True
            self.session_t0 = ts
            self.session_travel = 0.0
            self.session_clicked = False
            self.session_scrolled = False
            self.max_fingers = 0
            self.gesture_fired = False
            self.two_key = None
            self.primary = None
            self.stop_coast("touch")
        self.max_fingers = max(self.max_fingers, len(fingers))
        key = self.pick(fingers, ts)
        if key is None:
            if self.scrolling:
                self.why = "scroll end: " + self.why
                self.end_scroll(ts)
            self.primary = None  # everything is resting: nothing to follow
            self.t_ref = None
            return
        if len(key) == 2:
            self.two_fingers(key)
        x = sum(self.touches[t].x for t in key) / len(key)
        y = sum(self.touches[t].y for t in key) / len(key)
        self.follow(ts, key, x, y)

    def touchpad_frame(self, ts: float, fingers: list[int]) -> None:
        """Touchpad mode: hand the followed finger(s) to the virtual touchpad, plus one.
        The set of fingers on the virtual touchpad stays steady: every change makes libinput
        end one gesture and start another, and the browser waits for a busy page at every new
        start. So, as on a Mac: a touch goes down only once a finger really slides (not just
        rides along while the hand moves the mouse); a finger that reports too light for a
        moment while it slides stays down (TP_HOLD_SEC); a running scroll ignores any other
        finger; two fingers become the workspace swipe only when they slide sideways together
        from the start, and when one of them lifts the swipe is over (the other does not scroll
        on); a finger leaves only when it lifts: moving the mouse while scrolling is fine.
        A single finger lands where its slide began and catches up over a few frames, so a
        short flick is not cut to its tail."""
        gain = float(self.cfg["touchpad"]["swipe_gain"])
        swipe_on = self.cfg["touchpad"].get("swipe", True) is True
        key = self.tp_key
        if key is not None:
            keep = []
            for t in key:
                if t in fingers:
                    self.tp_light.pop(t, None)
                    keep.append(t)
                elif t in self.touches and not self.touches[t].grip \
                        and ts - self.tp_light.setdefault(t, ts) < TP_HOLD_SEC:
                    keep.append(t)  # lighter for a moment while it slides: still the same touch
            if len(key) >= 2 and len(keep) < len(key):
                keep = []  # one finger of a swipe lifted: the swipe is over, the other must not scroll
                self.tp_swiped = True
                for t in key:
                    o = self.touches.get(t)
                    if o is not None and o.edge0:
                        o.grip = True  # back to holding the mouse, as before the swipe
                        o.x0, o.y0, o.path, o.ptr0 = o.x, o.y, 0.0, self.ptr_total  # a new slide counts from here
            key = tuple(keep) or None
        if not fingers:
            self.tp_swiped = False
        cand = self.pick(fingers, ts) if fingers else None
        pair = self.fw_pair() if swipe_on and not self.tp_swiped else None
        if pair is not None and (key is None or (len(key) == 1 and key[0] in pair and ts - self.tp_t0 < TP_PAIR_YOUNG)) \
                and self.tp_engage(ts, pair):
            # The mouse says both touch and they slide sideways side by side: the swipe, at once (a light
            # swipe lasts only ~100 ms), edge fingers too, and from where they landed (catch-up).
            down = set(key or ())  # a finger already on the virtual touchpad stays where it is
            key = pair
            self.tp_pair_n = 0
            self.tp_t0 = ts
            for t in key:
                self.touches[t].grip = False
                if t not in down:
                    rx, ry = self.touches[t].recent()
                    self.tp_owed[t] = [-float(rx), -float(ry)]
                    self.tp_out.pop(t, None)
        elif key is not None:
            if len(key) == 1:
                t1 = self.touches[key[0]]
                dx, dy = t1.x - self.tp_from[0], t1.y - self.tp_from[1]
                sideways = abs(dx) >= TP_SWIPE_RATIO * abs(dy)
                cand = self.swipe_partner(key[0]) if swipe_on and (sideways or ts - self.tp_t0 < TP_PAIR_YOUNG) else None
            if len(key) == 1 and cand is not None:
                self.tp_pair_n += 1  # a second finger goes sideways along: a swipe after all
                if self.tp_pair_n >= TP_PAIR_FRAMES:
                    key = cand
                    self.tp_pair_n = 0
                    for t in key:
                        self.touches[t].grip = False
                    self.tp_owed.clear()  # no catch-up left that would move one finger of the pair
            else:
                self.tp_pair_n = 0
        elif self.tp_swiped:
            self.why = "swipe done: lift all fingers"
        elif cand is not None:
            if len(cand) == 2 and not (swipe_on and self.swipe_pair(cand)):
                # up and down (or swipe off), the fingers scroll together: one is enough (more would be a swipe)
                cand = (max(cand, key=lambda t: math.hypot(*self.touches[t].recent())),)
            if len(cand) == 1 and swipe_on:
                cand = self.swipe_partner(cand[0]) or cand  # sideways with a finger from the edge
            if self.tp_engage(ts, cand):
                key = cand
                self.tp_pair_n = 0
                self.tp_t0 = ts
                for t in key:
                    self.touches[t].grip = False  # an edge finger in a swipe slides: it is a finger now
                if len(key) == 1:  # land where the slide began: a short flick counts from its start
                    rx, ry = self.touches[key[0]].recent()
                    self.tp_from = (self.touches[key[0]].x - rx, self.touches[key[0]].y - ry)
                    self.tp_owed = {key[0]: [-float(rx), -float(ry)]}
        self.tp_key = key
        self.primary = key
        self.tp_light = {t: v for t, v in self.tp_light.items() if key and t in key}
        self.tp_owed = {t: v for t, v in self.tp_owed.items() if key and t in key}
        self.tp_out = {t: v for t, v in self.tp_out.items() if key and t in key}
        if key is None:
            if not fingers:
                light = [t.size for t in self.touches.values() if not t.grip]
                self.why = (f"not touching yet (size {max(light)})" if light
                            else "only grip fingers" if self.touches else "no touch")
            self.vpad.update([], gain)
            return
        pos = []
        for t in key:
            ox, oy = self.tp_owed.get(t, (0.0, 0.0))
            pos.append((t, *self.with_play(t, self.touches[t].x + ox, self.touches[t].y + oy)))
            if t in self.tp_owed:  # catch up over a few frames, not in one jump
                ox, oy = ox * TP_CATCH_UP, oy * TP_CATCH_UP
                self.tp_owed[t] = [ox, oy]
                if math.hypot(ox, oy) < 1.0:
                    del self.tp_owed[t]
        self.vpad.update(pos, gain, self.cfg["touchpad"].get("swipe_reverse") is True)
        self.why = f"touchpad: {len(key)} finger{'s' if len(key) > 1 else ''} -> {len(key) + 1}" + \
            (" (swipe)" if len(key) >= 2 else " (scroll)") + (" held" if self.tp_light else "")

    def with_play(self, t: int, x: float, y: float) -> tuple[float, float]:
        """Where finger t is on the virtual touchpad: it follows the real one with touch_reverse_mm
        of play on each axis (backlash), so a wobble within it moves nothing. It goes down at the
        trailing end of the play in the direction it slides, so the slide itself carries on at once."""
        play = max(float(self.cfg["scroll"].get("touch_reverse_mm", 0.0)), 0.0) * self.res_x
        out = self.tp_out.get(t)
        if out is None:
            rx, ry = self.touches[t].recent()
            out = self.tp_out[t] = [x - math.copysign(play, rx) if rx else x,
                                    y - math.copysign(play, ry) if ry else y]
        for i, v in enumerate((x, y)):
            if v > out[i] + play:
                out[i] = v - play
            elif v < out[i] - play:
                out[i] = v + play
        return out[0], out[1]

    def swipe_partner(self, t1: int) -> tuple[int, ...] | None:
        """t1 and another confirmed finger sliding sideways the same way, as a sorted pair. The
        other may have landed on an edge: holding the mouse there is ignored, a swipe is not."""
        ax, ay = self.touches[t1].recent()
        if abs(ax) < TP_SWIPE_RATIO * abs(ay) or abs(ax) / self.res_x < PAIR_MOVING_MM:
            return None
        best = None
        for t, o in self.touches.items():
            if t == t1 or o.palm or not o.ok or self.wobbling(o):
                continue
            bx, by = o.recent()
            m = abs(bx) / self.res_x
            if bx * ax > 0 and m >= MOVING_MM and abs(bx) >= TP_SWIPE_RATIO * abs(by) \
                    and m >= PAIR_RATIO * abs(ax) / self.res_x and (best is None or m > best[0]):
                best = (m, t)
        return tuple(sorted((t1, best[1]))) if best else None

    def fw_pair(self) -> tuple[int, ...] | None:
        """Two fingers the mouse itself calls touching, side by side, sliding sideways together:
        the workspace swipe. Edge fingers count: holding the mouse is not two neighbouring fingers
        sliding the same way. None without the mouse's own touch state."""
        live = [(t, o) for t, o in self.touches.items() if o.fw in FW_TOUCHING and not o.palm]
        best = None
        for i, (ta, a) in enumerate(live):
            ax, ay = a.recent()
            for tb, b in live[i + 1:]:
                bx, by = b.recent()
                ma, mb = abs(ax) / self.res_x, abs(bx) / self.res_x
                if ax * bx <= 0 or min(ma, mb) < MOVING_MM or max(ma, mb) < MIN_SLIDE_MM \
                        or min(ma, mb) < PAIR_RATIO * max(ma, mb):
                    continue  # not both moving the same way, enough
                if abs(ax + bx) < TP_SWIPE_RATIO * abs(ay + by):
                    continue  # more up and down than sideways: a scroll
                if math.hypot(a.x - b.x, a.y - b.y) / self.res_x > FW_PAIR_GAP_MM:
                    continue
                if best is None or ma + mb > best[0]:
                    best = (ma + mb, tuple(sorted((ta, tb))))
        return best[1] if best else None

    def swipe_pair(self, pair: tuple[int, ...]) -> bool:
        """Two fingers sliding sideways together: the workspace swipe, not a scroll."""
        vx = sum(self.touches[t].recent()[0] for t in pair) / self.res_x
        vy = sum(self.touches[t].recent()[1] for t in pair) / self.res_y
        return abs(vx) > 0 and abs(vx) >= TP_SWIPE_RATIO * abs(vy)

    def tp_engage(self, ts: float, key: tuple[int, ...]) -> bool:
        """May these fingers go down on the virtual touchpad? Same rules as a scroll start:
        not around a click, really sliding, and while the mouse moves, sliding clearly farther."""
        if self.pressed or ts - self.last_button_t < CLICK_QUIET:
            self.why = "button pressed or click pause"
            return False
        slide = self.key_recent_mm(key)
        if slide < (MIN_SLIDE_MM if len(key) >= 2 else MOVING_MM):
            # two fingers go down only when they clearly slide together: a hand holding the
            # mouse shifts two fingers slowly, and on the touchpad that would nudge the workspace
            self.why = "fingers resting" if slide < MOVING_MM else "two fingers creeping"
            return False
        if self.pointer_moving(ts) and (slide < MIN_SLIDE_MM or slide < POINTER_RATIO * self.pointer_mm(ts, MOVE_WINDOW)):
            self.why = "mouse moving: finger slide too small"
            return False
        if any(self.wobbling(self.touches[t]) for t in key):
            self.why = "finger wobbling on the spot (hover?)"
            return False
        return True

    def wobbling(self, t: Touch) -> bool:
        """Moving, but back and forth rather than one way: a finger hovering just above."""
        straight = float(self.cfg["scroll"].get("touch_straight", 0.0))
        return straight > 0 and t.straightness() < straight

    def confirm_touches(self, ts: float, reports: dict[int, int], fw: dict[int, int] | None = None) -> None:
        """Hysteresis on contact size: a finger counts once it touches firmly (big and
        closely spaced reports) and keeps counting until its size drops below the hold size.
        Two fingers on the small surface rarely press firmly (one often comes in from the side),
        so two fingers at touch_pair_size or more count at once, both of them.
        Where the mouse tells its own touch state (fw, touch_firmware on), that decides instead."""
        sc = self.cfg["scroll"]
        fw = fw if fw and sc.get("touch_firmware", True) else {}
        if not fw:
            for t in self.touches.values():
                t.fw = -1
        start = max(float(sc.get("touch_start_size", 0.0)), 0.0)
        hold = min(max(float(sc.get("touch_hold_size", 0.0)), 0.0), start)
        pair = min(max(float(sc.get("touch_pair_size", 0.0)), 0.0), start) or hold
        rate = float(sc.get("touch_rate", 0.0))
        max_gap = 1.0 / rate if rate > 0 else math.inf
        gaps = {}
        for tid, size in reports.items():
            t = self.touches.get(tid)
            if t is None:
                continue
            gap = ts - t.last_rep if t.last_rep is not None else 0.0
            t.last_rep, t.size = ts, size
            if gap > 0:
                t.rate = 1.0 / gap if t.rate == 0 else 0.8 * t.rate + 0.2 / gap
            gaps[tid] = gap
        present = [t for t in self.touches.values()
                   if not t.grip and t.last_rep is not None and ts - t.last_rep <= STALE_SEC / 3]
        two = sum(1 for t in present if t.size >= pair) >= 2
        anchor = any(t.ok for t in present)
        for tid, gap in gaps.items():
            t = self.touches[tid]
            if tid in fw:
                was, t.firm, t.fw = t.ok, 0, fw[tid]
                t.ok = fw[tid] in FW_TOUCHING
                if t.ok and not was and not t.grip:
                    anchor = True
                    self.stop_coast("touch")
                continue
            size = t.size
            if t.ok:
                if size < hold:
                    t.ok, t.firm = False, 0
                continue
            if start <= 0 or (not t.grip and (anchor or two) and size >= min(hold, pair)):
                t.ok = True  # off, or one of two fingers (next to a confirmed one, or two at once)
            elif size >= self.start_size(t, start):
                t.firm = t.firm + 1 if gap <= max_gap else 1
                t.ok = t.firm >= FIRM_REPORTS
            else:
                t.firm = 0
            if t.ok and not t.grip:
                anchor = True
                self.stop_coast("touch")

    def start_size(self, t: Touch, start: float) -> float:
        """The size a single finger needs to start where it is: touch_front_size within
        touch_front_mm of the front, easing back to the start size over as far again."""
        sc = self.cfg["scroll"]
        front = float(sc.get("touch_front_size", 0.0))
        depth = float(sc.get("touch_front_mm", 0.0))
        if front <= start or depth <= 0:
            return start
        mm_in = (t.y - self.y_min) / self.res_y
        share = min(max((2 * depth - mm_in) / depth, 0.0), 1.0)  # 1 up to depth, 0 from twice the depth
        return start + (front - start) * share

    def edge_finger_slides(self, ts: float, t: Touch) -> bool:
        """A finger that landed in the edge zone slides on the surface (not just with the hand)."""
        sc = self.cfg["scroll"]
        travel = math.hypot(t.x - t.x0, t.y - t.y0) / self.res_x
        hand_mm = (self.ptr_total - t.ptr0) * 25.4 / max(float(self.cfg["pointer"]["cpi"]), 1.0)
        if travel < float(sc["edge_release_mm"]) + POINTER_RATIO * hand_mm:
            return False  # drift, or the finger just rides along while the hand moves the mouse
        if travel < EDGE_STRAIGHT * t.path / self.res_x:
            return False  # it wobbles back and forth (a finger resting on the edge), it does not slide
        rx, ry = t.recent()
        slide = math.hypot(rx, ry) / self.res_x
        return slide >= MIN_SLIDE_MM and slide > POINTER_RATIO * self.pointer_mm(ts, MOVE_WINDOW)

    def pick(self, fingers: list[int], ts: float) -> tuple[int, ...] | None:
        """The finger(s) to follow: a scroll in progress keeps its own; otherwise the
        one that moves while the others rest, or two moving the same way."""
        def down(key: tuple[int, ...] | None) -> bool:
            return bool(key) and all(t in self.touches for t in key)

        if self.scrolling and down(self.primary):
            if len(self.primary) == 1 and len(fingers) >= 2:
                pair = self.partner(fingers, self.primary[0])
                if pair:
                    sideways = self.s_travel_x if self.axis == "xy" else self.s_travel
                    if (self.start_axis == "x" and ts - self.scroll_t0 < 0.25
                            and abs(sideways) < float(self.cfg["gestures"]["swipe_mm"])):
                        # a young sideways scroll that turns out to be two fingers is the
                        # workspace swipe, not a horizontal scroll (a finished page flick is kept)
                        self.scrolling = False
                        self.two_key = None
                        self.why = "second finger joined: two-finger swipe"
                    return pair
            if len(self.primary) == 2:
                (ma, a), (mb, b) = sorted(((math.hypot(*self.touches[t].recent()) / self.res_x, t) for t in self.primary), reverse=True)
                if mb < PAIR_MOVING_MM / 2 and ma >= MOVING_MM:
                    return (a,)  # the partner came to rest: follow the finger that still moves
            return self.primary
        if self.scrolling and len(fingers) == 1:
            return (fingers[0],)  # tracking id changed; keep the remaining finger
        if len(fingers) == 1:
            return (fingers[0],)
        moves = sorted(((math.hypot(*self.touches[t].recent()) / self.res_x, t) for t in fingers), reverse=True)
        (m1, t1), (m2, t2) = moves[0], moves[1]
        if m1 < MOVING_MM:
            self.why = "all fingers resting"
            return self.primary if down(self.primary) else None
        pair = self.partner(fingers, t1)
        if pair:
            return pair  # two fingers moving together
        if m2 >= MOVING_MM and m2 >= 0.5 * m1:
            self.why = "two fingers moving apart (pinch)"
            return None  # clearly moving apart: a pinch, not a scroll
        return (t1,)

    def partner(self, fingers: list[int], t1: int) -> tuple[int, ...] | None:
        """The finger moving along with t1, if any, as a sorted pair."""
        ax, ay = self.touches[t1].recent()
        m1 = math.hypot(ax, ay) / self.res_x
        best = None
        for t in fingers:
            if t == t1:
                continue
            bx, by = self.touches[t].recent()
            m = math.hypot(bx, by) / self.res_x
            if m >= PAIR_MOVING_MM and m >= PAIR_RATIO * m1 and ax * bx + ay * by > 0:
                if best is None or m > best[0]:
                    best = (m, t)
        return tuple(sorted((t1, best[1]))) if best else None

    def key_recent_mm(self, key: tuple[int, ...]) -> float:
        vx = sum(self.touches[t].recent()[0] for t in key) / len(key) / self.res_x
        vy = sum(self.touches[t].recent()[1] for t in key) / len(key) / self.res_y
        return math.hypot(vx, vy)

    def two_fingers(self, pair: tuple[int, ...]) -> None:
        g = self.cfg["gestures"]
        cx = sum(self.touches[t].x for t in pair) / 2
        cy = sum(self.touches[t].y for t in pair) / 2
        if self.two_key != pair:
            self.two_key = pair
            self.two_ref = (cx, cy)
            return
        dx_mm = (cx - self.two_ref[0]) / self.res_x
        dy_mm = (cy - self.two_ref[1]) / self.res_y
        self.session_travel = max(self.session_travel, math.hypot(dx_mm, dy_mm))
        if self.gesture_fired or self.scrolling:
            return  # a two-finger scroll that drifts sideways is not a workspace swipe
        if abs(dx_mm) >= float(g["swipe_mm"]) and abs(dx_mm) > HORIZONTAL_RATIO * abs(dy_mm):
            self.gesture_fired = True
            left = dx_mm < 0
            if g.get("invert_swipe"):
                left = not left
            action = str(g["two_finger_swipe_left"] if left else g["two_finger_swipe_right"])
            if self.verbose:
                log("two-finger swipe " + ("left" if dx_mm < 0 else "right"))
            self.why = "two-finger swipe " + ("left" if dx_mm < 0 else "right") + (" (inverted)" if g.get("invert_swipe") else "")
            self.why_locked = True
            end = str(g.get("swipe_end", "wrap"))
            if end not in ("wrap", "new", "stop"):
                end = "wrap"
            if WORKSPACE_NEXT in action or WORKSPACE_PREV in action:  # the default actions: our own stepping
                workspace_step(WORKSPACE_NEXT in action, end, action, bool(g.get("include_empty", True)))
            else:
                run_action(action)

    def follow(self, ts: float, key: tuple[int, ...], x: float, y: float) -> None:
        s = self.cfg["scroll"]
        if key != self.primary or self.t_ref is None:
            # a finger landed or started moving (or the pair changed): re-anchor.
            # If we were already scrolling, this is a tracking-id handoff: stay
            # in the scroll so a 1-report dropout does not swallow start_mm.
            if self.scrolling and self.verbose and key != self.primary:
                log(f"scroll handoff {self.primary} -> {key}")
            self.primary = key
            self.t_ref = (x, y)
            if not self.scrolling:
                self.s_vel = 0.0
                self.why = "finger landed or changed: anchor"
            self.s_last_t = ts
            return

        rx, ry = self.t_ref
        dx_mm = (x - rx) / self.res_x
        dy_mm = (y - ry) / self.res_y
        self.session_travel += math.hypot(dx_mm, dy_mm)

        if not self.scrolling:
            if self.pressed or ts - self.last_button_t < CLICK_QUIET:
                self.why = "button pressed or click pause"
                self.t_ref = (x, y)
                return
            if self.pointer_moving(ts):
                # The mouse is moving. A resting finger drifts a little with it; a finger
                # that scrolls slides much farther on the surface than the mouse travels
                # (a flick pushes the mouse too). Judge by the last MOVE_WINDOW only.
                vx = sum(self.touches[t].recent()[0] for t in key) / len(key) / self.res_x
                vy = sum(self.touches[t].recent()[1] for t in key) / len(key) / self.res_y
                slide = math.hypot(vx, vy)
                if slide < max(float(s["start_mm"]), MIN_SLIDE_MM) or slide < POINTER_RATIO * self.pointer_mm(ts, MOVE_WINDOW):
                    self.why = "mouse moving: finger slide too small"
                    self.t_ref = (x, y)
                    return
                dx_mm, dy_mm = vx, vy
            elif math.hypot(dx_mm, dy_mm) < float(s["start_mm"]):
                self.why = "below start distance"
                return  # not far enough yet
            elif self.key_recent_mm(key) < MOVING_MM:
                self.why = "finger only creeping"
                return  # a resting finger rolls and drifts slowly
            self.axis = "x" if abs(dx_mm) > HORIZONTAL_RATIO * abs(dy_mm) else "y"
            if self.axis == "x" and (not s["horizontal"] or len(key) == 2):
                if not self.why_locked:
                    self.why = "sideways with two fingers (gesture)" if len(key) == 2 else "horizontal scroll off"
                self.t_ref = (x, y)  # sideways with two fingers is the workspace gesture
                return
            self.start_axis = self.axis
            if s["free_axis"] and s["horizontal"]:
                self.axis = "xy"
            self.scrolling = True
            self.session_scrolled = True
            self.scroll_t0 = ts
            self.s_travel = 0.0
            self.s_travel_x = 0.0
            self.t_ref = (x, y)  # the start travel is swallowed, like macOS
            self.s_vel = 0.0
            self.s_speed = 0.0
            self.s_rem = {"x": 0.0, "y": 0.0}
            self.s_notch = {"x": 0, "y": 0}
            self.s_vel_xy = [0.0, 0.0]
            self.s_dir = [0.0, 0.0]
            self.s_last_t = ts
            self.why = f"scroll start ({len(key)} finger{'s' if len(key) > 1 else ''}, {self.axis})"
            if self.verbose:
                log(f"scroll start axis={self.axis} fingers={len(key)}")
            return

        # scrolling
        self.t_ref = (x, y)
        pointer = self.pointer_mm(ts, MOVE_WINDOW)
        if pointer >= MIN_SLIDE_MM and pointer > self.key_recent_mm(key):
            # the mouse moves farther than the finger slides: this is mousing now, not
            # scrolling (a resting finger wiggles as the hand pushes). Stop, no glide.
            self.scrolling = False
            self.why = "scroll stop: mouse moves more than finger"
            if self.verbose:
                log("scroll stop (pointer moving)")
            return
        self.why = f"scrolling ({len(key)} finger{'s' if len(key) > 1 else ''}, {self.axis})"
        if self.axis == "xy":
            # Decide on the smoothed direction, not on one noisy report: an axis only
            # counts while it carries a real share of the movement.
            k_dir = 1.0 - math.exp(-(max(ts - self.s_last_t, 0.0) * 1000.0) / FREE_DIR_MS)
            self.s_dir[0] += k_dir * (dx_mm - self.s_dir[0])
            self.s_dir[1] += k_dir * (dy_mm - self.s_dir[1])
            big = max(abs(self.s_dir[0]), abs(self.s_dir[1]))
            if abs(self.s_dir[0]) < FREE_MINOR * big:
                dx_mm = 0.0
            if abs(self.s_dir[1]) < FREE_MINOR * big:
                dy_mm = 0.0
            d_mm = math.hypot(dx_mm, dy_mm)
            self.s_travel_x += dx_mm
        else:
            d_mm = dy_mm if self.axis == "y" else dx_mm
        self.s_travel += d_mm
        dt = max(ts - self.s_last_t, 0.0)
        self.s_last_t = ts
        # Both estimates are smoothed with each report weighted by its dt, like the
        # pointer's velocity: Bluetooth delivers reports in bursts, and a burst
        # (dt ~ 0) must not read as a very fast finger. Still frames count too, so
        # a finger that stops before lifting has no momentum left.
        k_speed = 1.0 - math.exp(-(dt * 1000.0) / SCROLL_SPEED_MS)
        k_vel = 1.0 - math.exp(-(dt * 1000.0) / SCROLL_VEL_MS)
        self.s_speed += k_speed * ((abs(d_mm) / dt if dt > 0 else 0.0) - self.s_speed)
        ramp = 1.0 + float(s["accel"]) * min(max((self.s_speed - 75.0) / 370.0, 0.0), 2.0)
        gain = HIRES_PER_MM * float(s["speed"]) * ramp
        if self.axis == "xy":
            hx = self.scroll_sign("x") * dx_mm * gain
            hy = self.scroll_sign("y") * dy_mm * gain
            self.emit_scroll(hx, "x")
            self.emit_scroll(hy, "y")
            for i, h in enumerate((hx, hy)):
                self.s_vel_xy[i] += k_vel * ((h / dt if dt > 0 else 0.0) - self.s_vel_xy[i])
            self.s_vel = math.hypot(*self.s_vel_xy)
            return
        hires = self.scroll_sign(self.axis) * d_mm * gain
        self.emit_scroll(hires, self.axis)
        self.s_vel += k_vel * ((hires / dt if dt > 0 else 0.0) - self.s_vel)

    def scroll_sign(self, axis: str) -> float:
        """Map finger travel (touch units) to wheel sign.

        Kernel convention for the emulated wheel: finger moving toward the
        front of the mouse = ABS y decreasing = wheel rolled forward (positive,
        scroll up). Natural inverts that so content follows the finger.
        """
        s = self.cfg["scroll"]
        if axis == "y":
            sign = -1.0  # y decreasing (forward) -> positive wheel (non-natural)
            if s["invert_y"]:
                sign = -sign
        else:
            sign = 1.0  # x increasing (right) -> positive hwheel (scroll right)
            if s["invert_x"]:
                sign = -sign
        if s["natural"]:
            sign = -sign
        return sign

    def end_scroll(self, ts: float) -> None:
        g = self.cfg["gestures"]
        m = self.cfg["momentum"]
        # the lift report comes one report after the last move; only a longer gap means the finger had stopped
        fade = math.exp(-max(ts - self.s_last_t - NOMINAL_DT, 0.0) * 1000.0 / SCROLL_VEL_MS)
        self.s_vel *= fade
        self.s_vel_xy = [v * fade for v in self.s_vel_xy]
        sideways = self.s_travel_x if self.axis == "xy" else self.s_travel
        swipe = (
            (self.axis == "x" or (self.axis == "xy" and self.start_axis == "x")) and g["swipe_pages"]
            and (ts - self.scroll_t0) < 0.4 and abs(sideways) >= float(g["swipe_mm"])
        )
        if swipe:
            self.nav(back=sideways > 0)  # finger moving right = back, like macOS
        elif m["enabled"] and self.s_vel != 0.0 and abs(self.s_vel) >= float(m["flick"]):
            self.coasting = True
            self.c_vel = self.s_vel
            if self.axis == "xy":
                vx, vy = self.s_vel_xy
                self.c_dir = (vx / self.s_vel, vy / self.s_vel)
            self.c_t0 = ts
            self.c_last_t = ts
            self.s_rem = {"x": 0.0, "y": 0.0}
            if self.verbose:
                log(f"coast start {self.c_vel:.0f} hires/s axis={self.axis}")
        self.scrolling = False
        self.primary = None
        self.t_ref = None

    def end_session(self, ts: float) -> None:
        g = self.cfg["gestures"]
        dur = ts - self.session_t0
        if self.scrolling:
            self.end_scroll(ts)
        elif (not self.session_clicked and not self.gesture_fired and not self.session_scrolled
              and self.session_travel < 2.0 and dur < 0.3):
            # a tap (touch without click or travel); two in a row is a double tap
            if self.last_tap_t >= 0 and ts - self.last_tap_t < 0.4 and self.last_tap_fingers == self.max_fingers:
                self.last_tap_t = -1.0
                action = g["two_finger_double_tap"] if self.max_fingers >= 2 else g["double_tap"]
                if self.verbose:
                    log(f"double tap ({self.max_fingers} finger)")
                run_action(str(action))
            else:
                self.last_tap_t = ts
                self.last_tap_fingers = self.max_fingers
        self.scrolling = False
        self.t_ref = None
        self.primary = None
        self.session_open = False

    # ---- momentum
    def stop_coast(self, why: str) -> None:
        if self.coasting and self.verbose:
            log(f"coast stop ({why})")
        self.coasting = False
        self.c_vel = 0.0

    def tick(self, now: float) -> None:
        if not self.coasting:
            return
        m = self.cfg["momentum"]
        if now - self.c_t0 > float(m["max_seconds"]) or abs(self.c_vel) < float(m["stop"]):
            self.stop_coast("decay")
            return
        # Integrate over the time that really passed: the loop also wakes for mouse
        # reports and can run late, and a fixed step per call would make the glide
        # speed up, slow down and stutter with that. `decay` stays "per 8 ms tick".
        dt = min(max(now - self.c_last_t, 0.0), 0.05)
        self.c_last_t = now
        if dt == 0.0:
            return
        if self.axis == "xy":
            self.emit_scroll(self.c_vel * dt * self.c_dir[0], "x")
            self.emit_scroll(self.c_vel * dt * self.c_dir[1], "y")
        else:
            self.emit_scroll(self.c_vel * dt, self.axis)
        self.ui.syn()
        self.c_vel *= float(m["decay"]) ** (dt / TICK)


# --------------------------------------------------------------------------- main loop
class Session:
    """One grabbed Magic Mouse: its own Engine (touch tracking, virtual touchpad), battery and
    Hyprland settings for its touchpad. All mice share the config, the virtual mouse and Hyprland."""

    def __init__(self, dev: InputDevice, ui: UInput, cfg: dict, verbose: bool, bluez: BluezBattery | None) -> None:
        self.dev, self.bluez = dev, bluez
        self.eng = Engine(cfg, ui, verbose)
        self.hidraw = hidraw_for(dev)
        self.next_battery = 0.0
        self.next_kernel_battery = 0.0  # the kernel's charge, for Bluetooth settings (BluezBattery)
        self.queried: tuple[int, bool] | None = None  # (percent, charging) the mouse told us itself
        self.battery: tuple[int, bool] | None = None  # (percent, charging) as last known, for the bar
        self.vpad_cfg: str | None = None  # Hyprland settings last applied to the virtual touchpad
        self.vpad_retry = 0.0  # after a failed apply (Hyprland not up yet), try again from then
        log(f"grab {dev.path} ({dev.name} {dev.info.vendor:04x}:{dev.info.product:04x})")
        dev.grab()
        self.eng.attach(dev)
        self.sync_vpad()

    def geometry(self) -> dict:
        """The probe's hello for this mouse: name and touch surface."""
        dev = self.dev
        geo = {"model": dev.name, "product": f"{dev.info.product:04x}", "res": TOUCH_UNITS_PER_MM}
        for key, code in (("x", e.ABS_MT_POSITION_X), ("y", e.ABS_MT_POSITION_Y), ("major", e.ABS_MT_TOUCH_MAJOR)):
            try:
                info = dev.absinfo(code)
                geo[key] = [info.min, info.max]
            except OSError:
                pass
        return geo

    def sync_vpad(self) -> None:
        eng = self.eng
        want = bool(eng.cfg["touchpad"]["enabled"])
        if want and eng.vpad is None:
            try:
                eng.vpad = VPad((eng.x_min, eng.x_max), (eng.y_min, eng.y_max), eng.res_x)
                log("touchpad mode on")
            except Exception as exc:  # OSError, or python-evdev's UInputError
                log(f"touchpad mode: cannot create the virtual touchpad, staying off: {exc}")
                return
            eng.stop_coast("touchpad mode")
            eng.scrolling = False
            self.reset_tp()
            self.vpad_cfg = None
        elif not want and eng.vpad is not None:
            eng.vpad.close()
            eng.vpad = None
            self.reset_tp()
            log("touchpad mode off")
        if eng.vpad is not None:
            lua = vpad_lua(eng.cfg)
            if lua != self.vpad_cfg:
                reply = hypr_request("eval " + lua)
                self.vpad_cfg = lua if reply is not None and reply.strip() == "ok" else None
                if self.vpad_cfg is None:
                    self.vpad_retry = time.monotonic() + HyprEvents.RETRY_SEC

    def reset_tp(self) -> None:
        eng = self.eng
        eng.tp_key = None
        eng.tp_light.clear()
        eng.tp_owed.clear()
        eng.tp_out.clear()
        eng.tp_swiped = False
        eng.tp_pair_n = 0

    def poll(self, now: float) -> bool:
        """Battery and a pending touchpad settings retry. True if the charge changed (status to write)."""
        eng, dev, changed = self.eng, self.dev, False
        bat = eng.cfg["battery"]
        if bat["enabled"] and now >= self.next_battery:
            self.next_battery = now + max(float(bat["poll_minutes"]), 1.0) * 60.0
            self.next_kernel_battery = now  # settle the charge below right away
            got = query_battery(self.hidraw) if self.hidraw else None
            if got:
                self.queried = got
                log(f"battery {got[0]}%" + (" charging" if got[1] else ""))
            elif self.hidraw is None:
                log("battery: no hidraw node found for the mouse")
        if bat["enabled"] and now >= self.next_kernel_battery:
            self.next_kernel_battery = now + 60.0
            # One source, so the bar does not flip between two readings: the kernel's, which follows
            # the mouse, and our query's until the kernel knows (some mice never answer the query).
            kernel = kernel_battery(dev)
            pct = kernel if kernel is not None else (self.queried[0] if self.queried else None)
            now_bat = (pct, self.queried[1] if self.queried else False) if pct is not None else None
            if now_bat != self.battery:
                self.battery, changed = now_bat, True
            if self.bluez:
                if bat.get("bluez", True) and pct is not None:
                    self.bluez.set(dev.uniq, pct)
                elif not bat.get("bluez", True):
                    self.bluez.clear(dev.uniq)  # switched off live
        if eng.vpad is not None and self.vpad_cfg is None and now >= self.vpad_retry:
            self.sync_vpad()
        return changed

    def status(self) -> dict:
        d = {"model": self.dev.name, "address": self.dev.uniq or ""}
        if self.battery:
            d["percent"], d["charging"] = self.battery
        return d

    def read(self) -> bool:
        """Feed what the mouse sent. False when it is gone."""
        try:
            for ev in self.dev.read():
                self.eng.feed(ev)
        except OSError as exc:
            log(f"device gone: {exc}")
            return False
        return True

    def close(self) -> None:
        eng, dev = self.eng, self.dev
        if eng.vpad is not None:
            eng.vpad.close()
            eng.vpad = None
        eng.release_buttons()
        for fn in (dev.ungrab, dev.close):
            try:
                fn()
            except OSError:
                pass
        eng.reset_touch()
        if eng.probe:
            eng.probe.send({"type": "disconnected"})
            eng.probe = None
        if self.bluez:
            self.bluez.clear(dev.uniq)
        log(f"released grab ({dev.name})")


def publish_status(sessions: dict[str, Session]) -> None:
    """battery.json for the bar: every mouse under "mice"; the top level is the emptiest one
    (the bar's colour warns about it), as before a single mouse."""
    mice = [s.status() for s in sessions.values()]
    if not mice:
        write_status({"connected": False, "mice": [], "ts": time.time()})
        return
    known = [m for m in mice if "percent" in m]
    top = min(known, key=lambda m: m["percent"]) if known else mice[0]
    write_status(dict(top, connected=True, mice=mice, ts=time.time()))


def run(ui: UInput, cfg_path: str, verbose: bool, probe: Probe | None, hypr: HyprEvents,
        bluez: BluezBattery | None, record) -> None:
    """Grab every Magic Mouse that shows up, all in one select loop. The probe (preview window)
    follows the mouse last touched."""
    sessions: dict[str, Session] = {}
    active: Session | None = None
    cfg = load_config(cfg_path)
    mtime = config_mtime(cfg_path)
    next_cfg_check = next_scan = 0.0
    hypr_conn = hypr.connects
    publish_status(sessions)

    def make_active(s: Session | None) -> None:
        nonlocal active
        if s is active:
            return
        if active is not None:
            active.eng.probe = None
        active = s
        if probe and s is not None:
            s.eng.probe = probe
            probe.hello = s.geometry()
            probe.send(dict(probe.hello, type="hello"))
        elif probe:
            probe.send({"type": "disconnected"})

    def drop(path: str) -> None:
        s = sessions.pop(path)
        s.close()
        if s is active:
            make_active(next(iter(sessions.values()), None))
        publish_status(sessions)

    try:
        while True:
            now = time.monotonic()
            if now >= next_scan:
                next_scan = now + RESCAN_SEC
                for dev in find_mice(set(sessions)):
                    try:
                        s = Session(dev, ui, cfg, verbose, bluez)
                    except OSError as exc:
                        log(f"cannot grab {dev.path}: {exc}")
                        dev.close()
                        continue
                    s.eng.record = record
                    sessions[dev.path] = s
                    if active is None:
                        make_active(s)
                    publish_status(sessions)
            if any([s.poll(now) for s in sessions.values()]):
                publish_status(sessions)
            hypr.connect(now)
            if hypr.connects != hypr_conn:  # a new Hyprland (or a reconnect): settings are gone
                hypr_conn = hypr.connects
                for s in sessions.values():
                    s.vpad_cfg = None
            hypr.sync_binding(bool(cfg["buttons"]["control_click"]) and bool(sessions), now)
            coasting = any(s.eng.coasting for s in sessions.values())
            timeout = TICK if coasting else 0.25
            fds = [s.dev.fd for s in sessions.values()] + ([hypr] if hypr.sock else []) \
                + (probe.fds() if probe else [])
            r, _, _ = select.select(fds, [], [], timeout)
            if probe:
                probe.handle(r)
            now = time.monotonic()
            for path, s in list(sessions.items()):
                if s.dev.fd in r:
                    if not s.read():
                        drop(path)
                    elif s is not active and s.eng.touches:
                        make_active(s)  # the preview shows the mouse being touched
            if hypr in r:
                for line in hypr.read_lines():
                    if line == CONTROL_CLICK_EVENT and active is not None:
                        active.eng.control_click(time.time())
                    elif line.startswith("configreloaded>>"):
                        hypr.resync()  # a reload drops bindings added at runtime
                        for s in sessions.values():
                            s.vpad_cfg = None  # ...and the virtual touchpads' settings
                            s.sync_vpad()
            for s in sessions.values():
                if s.eng.coasting:
                    s.eng.tick(time.time())
            if now >= next_cfg_check:
                next_cfg_check = now + 1.0
                m = config_mtime(cfg_path)
                if m != mtime:
                    mtime = m
                    cfg = load_config(cfg_path)
                    for s in sessions.values():
                        s.eng.update_config(cfg)
                        s.sync_vpad()
                    log("config reloaded")
    finally:
        for path in list(sessions):
            drop(path)


def main() -> int:
    ap = argparse.ArgumentParser(description="Mac-like Magic Mouse daemon")
    ap.add_argument("--config", default=CONFIG_PATH, help="TOML config path")
    ap.add_argument("--verbose", action="store_true", help="log scroll starts and momentum")
    ap.add_argument("--list", action="store_true", help="show detected Magic Mouse and exit")
    ap.add_argument("--record", metavar="PATH", help="append the mouse's raw input events to PATH (for debugging)")
    ap.add_argument("--no-probe", action="store_true", help="do not open the live touch socket for the preview window")
    args = ap.parse_args()

    if args.list:
        mice = find_mice(set())
        if not mice:
            print("no Magic Mouse found (is it connected? is hid_magicmouse bound?)")
            return 1
        for dev in mice:
            print(f"{dev.path}: {dev.name} {dev.info.vendor:04x}:{dev.info.product:04x}")
        return 0

    cfg = load_config(args.config)
    log(f"magic-mouse-daemon pid={os.getpid()} config={args.config}")
    ui = make_uinput()
    log(f"virtual device '{VIRT_NAME}' ready")
    record = None
    if args.record:
        record = open(args.record, "a", buffering=1)
        log(f"recording raw input to {args.record}")
    probe = None
    if not args.no_probe:
        probe = Probe()
        probe.open()
    hypr = HyprEvents()
    bluez = BluezBattery()  # always: battery.bluez can be switched on and off live
    # systemctl stop sends SIGTERM; exit through the finally blocks so buttons
    # are released and the Control-click binding is taken back out of Hyprland.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        run(ui, args.config, args.verbose, probe, hypr, bluez, record)
    except KeyboardInterrupt:
        log("interrupt")
    finally:
        if hypr.sock and hypr.bound:
            hypr.sync_binding(False, time.monotonic())
        hypr.close()
        if probe:
            probe.close()
        ui.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
