#!/bin/sh
# magic-mouse-config: read or change ~/.config/magic-mouse/config.toml, keeping comments.
#
#   magic-mouse-config get                       # effective config as JSON (defaults merged)
#   magic-mouse-config defaults                  # built-in defaults as JSON
#   magic-mouse-config set pointer.tracking_speed=1.0 scroll.natural=true
#
# The work is done by the magic-mouse-daemon next to this file (`magic-mouse-daemon config ...`).
# When that is the Python daemon (install.sh's fallback), magic-mouse-config.py does it instead.
here=$(dirname "$(readlink -f "$0")")
daemon="$here/magic-mouse-daemon"
if [ "$(head -c 2 "$daemon" 2>/dev/null)" = "#!" ]; then
  exec /usr/bin/python3 "$here/magic-mouse-config.py" "$@"
fi
exec "$daemon" config "$@"
